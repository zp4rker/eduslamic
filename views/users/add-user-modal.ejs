<!-- Modal for adding user -->
<div id="add-user-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-40 hidden">
    <div class="bg-white rounded-lg shadow-lg w-full max-w-md p-8 relative max-h-[90vh] overflow-y-auto">
        <button id="close-add-user-modal" class="absolute top-2 right-2 text-gray-400 hover:text-gray-700 focus:outline-none">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
        <h3 class="text-xl font-semibold mb-6 text-gray-800">Create New User</h3>
        <form action="/users/create" method="POST" class="space-y-4">
            <div>
                <label for="name" class="block mb-1 font-medium text-gray-700">Full Name *</label>
                <input type="text" id="name" name="name" value="<%= typeof values !== 'undefined' ? values.name || '' : '' %>" required class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
            </div>
            
            <div>
                <label for="email" class="block mb-1 font-medium text-gray-700">Email *</label>
                <input type="email" id="email" name="email" value="<%= typeof values !== 'undefined' ? values.email || '' : '' %>" required class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
            </div>

            <div>
                <label for="phone" class="block mb-1 font-medium text-gray-700">Phone</label>
                <input type="tel" id="phone" name="phone" value="<%= typeof values !== 'undefined' ? values.phone || '' : '' %>" class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
            </div>

            <div>
                <label for="role" class="block mb-1 font-medium text-gray-700">Role *</label>
                <select id="role" name="role" required class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
                    <option value="">Select Role</option>
                    <% Object.values(roles).forEach(role => { %>
                        <option value="<%= role %>" <%= typeof values !== 'undefined' && values.role === role ? 'selected' : '' %>><%= role.charAt(0).toUpperCase() + role.slice(1) %></option>
                    <% }); %>
                </select>
            </div>

            <div>
                <label for="password" class="block mb-1 font-medium text-gray-700">Password *</label>
                <input type="password" id="password" name="password" required class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
                <p class="text-xs text-gray-500 mt-1">Minimum 6 characters</p>
            </div>

            <div>
                <label for="confirmPassword" class="block mb-1 font-medium text-gray-700">Confirm Password *</label>
                <input type="password" id="confirmPassword" name="confirmPassword" required class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
            </div>

            <button type="submit" class="w-full px-4 py-2 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-green-400 focus:ring-offset-2 transform hover:scale-105 hover:shadow-xl">
                Create User
            </button>
        </form>
    </div>
</div>

<script>
    document.getElementById('add-user-button').addEventListener('click', function(e) {
        e.preventDefault();
        document.getElementById('add-user-modal').classList.remove('hidden');
    });

    document.getElementById('close-add-user-modal').addEventListener('click', function() {
        document.getElementById('add-user-modal').classList.add('hidden');
    });
    
    // Close modal on background click
    document.getElementById('add-user-modal').addEventListener('click', function(e) {
        if (e.target === this) {
            this.classList.add('hidden');
        }
    });
</script>