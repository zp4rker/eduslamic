<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Student - Education CRM</title>
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/students.css">
</head>
<body>
    <div class="header">
        <h1>Education CRM</h1>
        <div class="user-info">
            <span class="user-name">Welcome, <%= user.name %></span>
            <a href="/students" class="back-btn">Back to Students</a>
            <a href="/auth/logout" class="logout-btn">Logout</a>
        </div>
    </div>
    
    <div class="container">
        <% if (error) { %>
            <div class="message error">
                <%= error %>
            </div>
        <% } %>
        
        <div class="card">
            <h2>Create New Student</h2>
            
            <form action="/students/create" method="POST">
                <div class="form-group">
                    <label for="firstName">First Name *</label>
                    <input 
                        type="text" 
                        id="firstName" 
                        name="firstName" 
                        value="<%= values.firstName || '' %>" 
                        required
                    >
                </div>
                
                <div class="form-group">
                    <label for="lastName">Last Name *</label>
                    <input 
                        type="text" 
                        id="lastName" 
                        name="lastName" 
                        value="<%= values.lastName || '' %>" 
                        required
                    >
                </div>
                
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        value="<%= values.email || '' %>"
                    >
                </div>
                
                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input 
                        type="tel" 
                        id="phone" 
                        name="phone" 
                        value="<%= values.phone || '' %>"
                    >
                </div>
                
                <div class="form-group">
                    <label for="dateOfBirth">Date of Birth</label>
                    <input 
                        type="date" 
                        id="dateOfBirth" 
                        name="dateOfBirth" 
                        value="<%= values.dateOfBirth || '' %>"
                    >
                </div>
                
                <div class="form-group">
                    <label for="address">Address</label>
                    <textarea 
                        id="address" 
                        name="address"
                    ><%= values.address || '' %></textarea>
                </div>
                
                <h3>Parent/Guardian Information</h3>
                
                <div class="row">
                    <div class="col-50">
                        <div class="form-group">
                            <label for="parentName">Parent/Guardian Name</label>
                            <input 
                                type="text" 
                                id="parentName" 
                                name="parentName" 
                                value="<%= values.parentName || '' %>"
                            >
                        </div>
                    </div>
                    <div class="col-50">
                        <div class="form-group">
                            <label for="parentEmail">Parent/Guardian Email</label>
                            <input 
                                type="email" 
                                id="parentEmail" 
                                name="parentEmail" 
                                value="<%= values.parentEmail || '' %>"
                            >
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-50">
                        <div class="form-group">
                            <label for="parentPhone">Parent/Guardian Phone</label>
                            <input 
                                type="tel" 
                                id="parentPhone" 
                                name="parentPhone" 
                                value="<%= values.parentPhone || '' %>"
                            >
                        </div>
                    </div>
                    <div class="col-50">
                        <div class="form-group">
                            <label for="relationship">Relationship</label>
                            <input 
                                type="text" 
                                id="relationship" 
                                name="relationship" 
                                value="<%= values.relationship || '' %>"
                                placeholder="e.g., Father, Mother, Guardian"
                            >
                        </div>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="notes">Additional Notes</label>
                    <textarea 
                        id="notes" 
                        name="notes"
                    ><%= values.notes || '' %></textarea>
                </div>
                
                <button type="submit">Create Student</button>
            </form>
        </div>
    </div>
</body>
</html>