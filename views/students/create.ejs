<div class="max-w-5xl mx-auto mt-8 px-4">
    <%- include('../partials/alerts', { error: error }) %>
    <div class="bg-white border border-gray-200 rounded-lg shadow-md p-8">
        <h2 class="text-xl font-semibold mb-6 text-gray-800">Create New Student</h2>
        <form action="/students/create" method="POST" class="space-y-4">
            <div>
                <label for="firstName" class="block mb-1 font-medium text-gray-700">First Name *</label>
                <input type="text" id="firstName" name="firstName" value="<%= values.firstName || '' %>" required class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
            </div>
            <div>
                <label for="lastName" class="block mb-1 font-medium text-gray-700">Last Name *</label>
                <input type="text" id="lastName" name="lastName" value="<%= values.lastName || '' %>" required class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
            </div>
            <div>
                <label for="email" class="block mb-1 font-medium text-gray-700">Email Address</label>
                <input type="email" id="email" name="email" value="<%= values.email || '' %>" class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
            </div>
            <div>
                <label for="phone" class="block mb-1 font-medium text-gray-700">Phone Number</label>
                <input type="tel" id="phone" name="phone" value="<%= values.phone || '' %>" class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
            </div>
            <div>
                <label for="dateOfBirth" class="block mb-1 font-medium text-gray-700">Date of Birth</label>
                <input type="date" id="dateOfBirth" name="dateOfBirth" value="<%= values.dateOfBirth || '' %>" class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
            </div>
            <div>
                <label for="address" class="block mb-1 font-medium text-gray-700">Address</label>
                <textarea id="address" name="address" class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full resize-vertical h-24"><%= values.address || '' %></textarea>
            </div>
            <h3 class="text-lg font-semibold mt-8 mb-2 text-gray-800">Parent/Guardian Information</h3>
            <div class="flex flex-wrap -mx-2 gap-y-4">
                <div class="w-full md:w-1/2 px-2">
                    <label for="parentName" class="block mb-1 font-medium text-gray-700">Parent/Guardian Name</label>
                    <input type="text" id="parentName" name="parentName" value="<%= values.parentName || '' %>" class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
                </div>
                <div class="w-full md:w-1/2 px-2">
                    <label for="parentEmail" class="block mb-1 font-medium text-gray-700">Parent/Guardian Email</label>
                    <input type="email" id="parentEmail" name="parentEmail" value="<%= values.parentEmail || '' %>" class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
                </div>
            </div>
            <div class="flex flex-wrap -mx-2 gap-y-4">
                <div class="w-full md:w-1/2 px-2">
                    <label for="parentPhone" class="block mb-1 font-medium text-gray-700">Parent/Guardian Phone</label>
                    <input type="tel" id="parentPhone" name="parentPhone" value="<%= values.parentPhone || '' %>" class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
                </div>
                <div class="w-full md:w-1/2 px-2">
                    <label for="relationship" class="block mb-1 font-medium text-gray-700">Relationship</label>
                    <input type="text" id="relationship" name="relationship" value="<%= values.relationship || '' %>" placeholder="e.g., Father, Mother, Guardian" class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
                </div>
            </div>
            <div>
                <label for="notes" class="block mb-1 font-medium text-gray-700">Additional Notes</label>
                <textarea id="notes" name="notes" class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full resize-vertical h-24"><%= values.notes || '' %></textarea>
            </div>
            <button type="submit" class="w-full px-4 py-2 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-green-400 focus:ring-offset-2 transform hover:scale-105 hover:shadow-xl">
                Create Student
            </button>
        </form>
    </div>
</div>