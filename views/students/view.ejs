<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Student - Education CRM</title>
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/students.css">
</head>
<body>
    <div class="header">
        <h1>Education CRM</h1>
        <div class="user-info">
            <span class="user-name">Welcome, <%= user.name %></span>
            <a href="/students" class="back-btn">Back to Students</a>
            <a href="/students/edit/<%= student._id %>" class="edit-btn">Edit Student</a>
            <a href="/auth/logout" class="logout-btn">Logout</a>
        </div>
    </div>
    
    <div class="container">
        <div class="card">
            <h2>Student Details</h2>
            
            <div class="info-section">
                <div class="info-row">
                    <div class="info-label">Name:</div>
                    <div class="info-value"><%= student.name %></div>
                </div>
                <div class="info-row">
                    <div class="info-label">Date of Birth:</div>
                    <div class="info-value"><%= student.formattedDob || 'Not specified' %></div>
                </div>
                <div class="info-row">
                    <div class="info-label">Created:</div>
                    <div class="info-value"><%= new Date(student.createdAt).toLocaleString() %></div>
                </div>
                <% if(student.updatedAt) { %>
                <div class="info-row">
                    <div class="info-label">Last Updated:</div>
                    <div class="info-value"><%= new Date(student.updatedAt).toLocaleString() %></div>
                </div>
                <% } %>
            </div>
            
            <h3 class="section-title">Parents</h3>
            <% if(student.parents && student.parents.length > 0) { %>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% student.parents.forEach(parent => { %>
                            <tr>
                                <td><%= parent.name %></td>
                                <td><%= parent.email %></td>
                                <td><%= parent.phone || 'Not specified' %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <p class="no-data">No parents linked to this student.</p>
            <% } %>
            
            <h3 class="section-title">Enrolled Classes</h3>
            <% if(student.classes && student.classes.length > 0) { %>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Class Name</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% student.classes.forEach(classObj => { %>
                            <tr>
                                <td><%= classObj.name %></td>
                                <td><%= classObj.description || 'No description' %></td>
                                <td>
                                    <a href="/classes/view/<%= classObj._id %>" class="btn">View Class</a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <p class="no-data">Student is not enrolled in any classes.</p>
            <% } %>
        </div>
    </div>
</body>
</html>