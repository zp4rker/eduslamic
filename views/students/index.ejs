<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students - Education CRM</title>
    <link rel="stylesheet" href="/styles/tailwind.css">
</head>
<body class="bg-gray-50 min-h-screen">
    <div class="bg-green-600 text-white px-6 py-4 flex items-center justify-between">
        <h1 class="text-2xl font-bold">Education CRM</h1>
        <div class="flex items-center space-x-4">
            <a href="/" class="px-4 py-2 rounded border border-white text-white hover:bg-white hover:text-black transition-colors duration-150 mr-2">Dashboard</a>
            <a href="/classes" class="px-4 py-2 rounded border border-white text-white hover:bg-white hover:text-black transition-colors duration-150 mr-2">Classes</a>
            <a href="/auth/logout" class="px-4 py-2 rounded border border-white text-white hover:bg-white hover:text-black transition-colors duration-150">Logout</a>
        </div>
    </div>
    <div class="max-w-5xl mx-auto mt-8 px-4">
        <% if (success) { %>
            <div class="mb-4 px-4 py-2 rounded bg-green-100 text-green-800 border border-green-300">
                <%= success %>
            </div>
        <% } %>
        <% if (error) { %>
            <div class="mb-4 px-4 py-2 rounded bg-red-100 text-red-800 border border-red-300">
                <%= error %>
            </div>
        <% } %>
        <div class="bg-white border border-gray-200 rounded-lg shadow-md p-8 mb-8 space-y-6">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-semibold">Student Management</h2>
                <a href="/students/create" class="px-4 py-2 rounded bg-green-600 text-white hover:bg-green-700 transition-colors duration-150">Add New Student</a>
            </div>
            <% if (students && students.length > 0) { %>
                <div class="overflow-x-auto">
                    <table class="min-w-full bg-white border border-gray-200 rounded-lg">
                        <thead>
                            <tr class="bg-gray-100">
                                <th class="px-4 py-2 text-left font-medium text-gray-700">Name</th>
                                <th class="px-4 py-2 text-left font-medium text-gray-700">Date of Birth</th>
                                <th class="px-4 py-2 text-left font-medium text-gray-700">Created At</th>
                                <th class="px-4 py-2 text-left font-medium text-gray-700">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% students.forEach(student => { %>
                                <tr class="border-t border-gray-100 hover:bg-gray-50">
                                    <td class="px-4 py-2"><%= student.name %></td>
                                    <td class="px-4 py-2"><%= student.formattedDob || 'Not specified' %></td>
                                    <td class="px-4 py-2"><%= new Date(student.createdAt).toLocaleDateString() %></td>
                                    <td class="px-4 py-2">
                                        <div class="flex flex-wrap gap-2">
                                            <a href="/students/view/<%= student._id %>" class="px-3 py-1 rounded bg-blue-600 text-white hover:bg-blue-700 transition-colors duration-150">View</a>
                                            <a href="/students/edit/<%= student._id %>" class="px-3 py-1 rounded bg-yellow-500 text-white hover:bg-yellow-600 transition-colors duration-150">Edit</a>
                                            <form action="/students/delete/<%= student._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this student?');" class="inline">
                                                <button type="submit" class="px-3 py-1 rounded bg-red-600 text-white hover:bg-red-700 transition-colors duration-150">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p class="text-gray-600">No students found. Add a new student to get started.</p>
            <% } %>
        </div>
    </div>
</body>
</html>