<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students - Education CRM</title>
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/students.css">
</head>
<body>
    <div class="header">
        <h1>Education CRM</h1>
        <div class="user-info">
            <span class="user-name">Welcome, <%= user.name %></span>
            <a href="/" class="dashboard-btn">Dashboard</a>
            <a href="/classes" class="classes-btn">Classes</a>
            <a href="/auth/logout" class="logout-btn">Logout</a>
        </div>
    </div>
    
    <div class="container">
        <% if (success) { %>
            <div class="message success">
                <%= success %>
            </div>
        <% } %>
        
        <% if (error) { %>
            <div class="message error">
                <%= error %>
            </div>
        <% } %>
        
        <div class="card">
            <h2>
                Student Management
                <a href="/students/create" class="btn">Add New Student</a>
            </h2>
            
            <% if (students && students.length > 0) { %>
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Date of Birth</th>
                            <th>Created At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% students.forEach(student => { %>
                            <tr>
                                <td><%= student.name %></td>
                                <td><%= student.formattedDob || 'Not specified' %></td>
                                <td><%= new Date(student.createdAt).toLocaleDateString() %></td>
                                <td class="actions">
                                    <a href="/students/view/<%= student._id %>" class="btn">View</a>
                                    <a href="/students/edit/<%= student._id %>" class="btn">Edit</a>
                                    <form action="/students/delete/<%= student._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this student?');" style="display: inline;">
                                        <button type="submit" class="btn delete">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <p>No students found. Add a new student to get started.</p>
            <% } %>
        </div>
    </div>
</body>
</html>