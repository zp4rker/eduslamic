<div class="max-w-5xl mx-auto mt-8 px-4">
    <%- include('../partials/alerts', { success: success, error: error }) %>
    <div class="bg-white border border-gray-200 rounded-lg shadow-md p-8 mb-8 space-y-6">
        <h2 class="text-xl font-semibold">Student Management</h2>
        <!-- Button to trigger modal -->
        <button id="add-student-button" type="button" class="mt-2 inline-block px-4 py-2 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-xl">
            Add New Student
        </button>
        <% if (students && students.length > 0) { %>
            <div class="overflow-x-auto">
                <table class="min-w-full bg-white border border-gray-200 rounded-lg">
                    <thead>
                        <tr class="bg-gray-100">
                            <th class="px-4 py-2 text-left font-medium text-gray-700">Name</th>
                            <th class="px-4 py-2 text-left font-medium text-gray-700">Date of Birth</th>
                            <th class="px-4 py-2 text-left font-medium text-gray-700">Created At</th>
                            <th class="px-4 py-2 text-left font-medium text-gray-700">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% students.forEach(student => { %>
                            <tr class="border-t border-gray-100 hover:bg-gray-50">
                                <td class="px-4 py-2"><%= student.name %></td>
                                <td class="px-4 py-2"><%= student.formattedDob || 'Not specified' %></td>
                                <td class="px-4 py-2"><%= new Date(student.createdAt).toLocaleDateString() %></td>
                                <td class="px-4 py-2">
                                    <div class="flex flex-wrap gap-2">
                                        <a href="/students/view/<%= student._id %>" class="px-3 py-1 bg-blue-600 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-xl">View</a>
                                        <button 
                                            type="button" 
                                            class="edit-student-button px-3 py-1 bg-yellow-500 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-xl"
                                            data-id="<%= student._id %>"
                                            data-name="<%= student.name %>"
                                            data-dob="<%= student.dateOfBirth ? new Date(student.dateOfBirth).toISOString().split('T')[0] : '' %>">
                                            Edit
                                        </button>
                                        <form action="/students/delete/<%= student._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this student?');" class="inline">
                                            <button type="submit" class="px-3 py-1 bg-red-600 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-xl">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p class="text-gray-600">No students found. Add a new student to get started.</p>
        <% } %>
    </div>

    <!-- Include modals -->
    <%- include('./add-student-modal') %>
    <%- include('./edit-student-modal') %>
</div>