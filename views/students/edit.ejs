<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Student - Education CRM</title>
    <link rel="stylesheet" href="/styles/tailwind.css">
</head>
<body class="bg-gray-50 min-h-screen">
    <div class="bg-green-600 text-white px-6 py-4 flex items-center justify-between">
        <h1 class="text-2xl font-bold">Education CRM</h1>
        <div class="flex items-center space-x-4">
            <a href="/students" class="px-4 py-2 rounded border border-white text-white hover:bg-white hover:text-black transition-colors duration-150">Back to Students</a>
            <a href="/auth/logout" class="px-4 py-2 rounded border border-white text-white hover:bg-white hover:text-black transition-colors duration-150">Logout</a>
        </div>
    </div>
    <div class="max-w-5xl mx-auto mt-8 px-4">
        <% if (error) { %>
            <div class="mb-4 px-4 py-2 rounded bg-red-100 text-red-800 border border-red-300 text-center">
                <%= error %>
            </div>
        <% } %>
        <div class="bg-white border border-gray-200 rounded-lg shadow-md p-8 mb-8">
            <h2 class="text-xl font-semibold mb-6 text-gray-800">Edit Student: <%= student.name %></h2>
            <form action="/students/edit/<%= student._id %>" method="POST" class="space-y-4 max-w-lg">
                <div>
                    <label for="name" class="block mb-1 font-medium text-gray-700">Full Name *</label>
                    <input type="text" id="name" name="name" value="<%= student.name %>" required class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
                </div>
                <div>
                    <label for="dateOfBirth" class="block mb-1 font-medium text-gray-700">Date of Birth *</label>
                    <input type="date" id="dateOfBirth" name="dateOfBirth" value="<%= student.dateOfBirth ? student.dateOfBirth.substring(0, 10) : '' %>" required class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
                </div>
                <div>
                    <label class="block mb-1 font-medium text-gray-700">Parents (optional)</label>
                    <% if (allParents && allParents.length > 0) { %>
                        <div class="max-h-52 overflow-y-auto border border-gray-200 rounded p-3">
                            <% allParents.forEach(parent => { %>
                                <div class="flex items-center mb-2">
                                    <input type="checkbox" id="parent-<%= parent._id %>" name="parentIds" value="<%= parent._id %>" <% if (linkedParentIds.includes(parent._id)) { %>checked<% } %> class="mr-2">
                                    <label for="parent-<%= parent._id %>" class="text-gray-700"><%= parent.name %> (<%= parent.email %>)</label>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <p class="text-gray-600 italic">No parent accounts available.</p>
                    <% } %>
                </div>
                <button type="submit" class="w-full px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 font-semibold transition-colors duration-150">Update Student</button>
            </form>
        </div>
    </div>
</body>
</html>