<% var success = typeof success !== 'undefined' ? success : null; %>
<% var error = typeof error !== 'undefined' ? error : null; %>
<div class="max-w-5xl mx-auto mt-8 px-4">
    <%- include('../../partials/alerts', { success: success, error: error }) %>
    <div class="bg-white border border-gray-200 rounded-lg shadow-md p-8 mb-8 space-y-6">
        <h2 class="text-xl font-semibold">User Management</h2>
        <!-- Button to trigger add user modal -->
        <button id="add-user-button" type="button" class="mt-2 inline-block px-4 py-2 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-xl">
            Add New User
        </button>
        
        <% if (users && users.length > 0) { %>
            <div class="overflow-x-auto mt-6">
                <table class="min-w-full bg-white border border-gray-200 rounded-lg">
                    <thead>
                        <tr class="bg-gray-100">
                            <th class="px-4 py-2 text-left font-medium text-gray-700">Name</th>
                            <th class="px-4 py-2 text-left font-medium text-gray-700">Email</th>
                            <th class="px-4 py-2 text-left font-medium text-gray-700">Phone</th>
                            <th class="px-4 py-2 text-left font-medium text-gray-700">Role</th>
                            <th class="px-4 py-2 text-left font-medium text-gray-700">Created At</th>
                            <th class="px-4 py-2 text-left font-medium text-gray-700">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(user => { %>
                            <tr class="border-t border-gray-100 hover:bg-gray-50">
                                <td class="px-4 py-2"><%= user.name %></td>
                                <td class="px-4 py-2"><%= user.email %></td>
                                <td class="px-4 py-2"><%= user.phone || 'Not specified' %></td>
                                <td class="px-4 py-2">
                                    <% 
                                    let roleBadgeClass = '';
                                    switch(user.role) {
                                        case 'admin':
                                            roleBadgeClass = 'bg-red-100 text-red-800 border border-red-300';
                                            break;
                                        case 'teacher':
                                            roleBadgeClass = 'bg-blue-100 text-blue-800 border border-blue-300';
                                            break;
                                        default:
                                            roleBadgeClass = 'bg-green-100 text-green-800 border border-green-300';
                                    }
                                    %>
                                    <span class="px-2 py-1 rounded-full text-xs <%= roleBadgeClass %>">
                                        <%= user.role ? (user.role.charAt(0).toUpperCase() + user.role.slice(1)) : 'Unknown' %>
                                    </span>
                                </td>
                                <td class="px-4 py-2"><%= new Date(user.createdAt).toLocaleDateString() %></td>
                                <td class="px-4 py-2">
                                    <div class="flex flex-wrap gap-2">
                                        <button 
                                            type="button" 
                                            class="edit-user-button p-2 bg-yellow-500 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-xl"
                                            data-id="<%= user._id %>"
                                            data-name="<%= user.name %>"
                                            data-email="<%= user.email %>"
                                            data-phone="<%= user.phone || '' %>"
                                            data-role="<%= user.role %>"
                                            title="Edit User">
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                        </button>
                                        <button 
                                            type="button" 
                                            class="reset-password-button p-2 bg-blue-600 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-xl"
                                            data-id="<%= user._id %>"
                                            data-name="<%= user.name %>"
                                            title="Reset Password">
                                            <!-- Alternative cleaner SVG icon -->
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                                            </svg>
                                        </button>
                                        <% if (user._id !== session.user._id) { %>
                                            <form action="/users/delete/<%= user._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this user?');" class="inline">
                                                <button type="submit" class="p-2 bg-red-600 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-xl" title="Delete User">
                                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p class="text-gray-600">No users found.</p>
        <% } %>
    </div>

    <!-- Include modals -->
    <%- include('./add-user-modal') %>
    <%- include('./edit-user-modal') %>
    <%- include('./reset-password-modal') %>
</div>