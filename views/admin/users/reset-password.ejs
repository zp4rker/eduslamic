<%# views/admin/users/reset-password.ejs %>
<% var success = typeof success !== 'undefined' ? success : null; %>
<% var error = typeof error !== 'undefined' ? error : null; %>
<% var userToReset = typeof userToReset !== 'undefined' ? userToReset : {}; %>

<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <%- include('../../partials/alerts', { success: success, error: error }) %>

    <!-- Page Header -->
    <div class="px-4 py-6 sm:px-0 mb-8">
        <h1 class="text-3xl font-bold leading-tight text-gray-900">
            Reset Password for: <%= userToReset.name %>
        </h1>
    </div>

    <!-- Main Content Card -->
    <div class="bg-white shadow-lg rounded-lg overflow-hidden border border-gray-200">
        <div class="px-6 py-5 bg-gray-50 border-b border-gray-200">
            <h2 class="text-xl font-semibold text-gray-800">Set New Password</h2>
        </div>
        <div class="px-6 py-6">
            <form id="reset-password-form" action="/admin/users/reset-password/<%= userToReset._id %>" method="POST" class="space-y-4">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"> <%# Optional CSRF token %>

                <div>
                    <label for="reset-new-password" class="block text-sm font-medium text-gray-700">New Password *</label>
                    <input type="password" id="reset-new-password" name="newPassword" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                    <p class="text-xs text-gray-500 mt-1">Minimum 6 characters</p>
                </div>

                <div>
                    <label for="reset-confirm-password" class="block text-sm font-medium text-gray-700">Confirm New Password *</label>
                    <input type="password" id="reset-confirm-password" name="confirmPassword" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                </div>

                <!-- Action Buttons -->
                <div class="pt-4 flex justify-end space-x-3">
                     <a href="/admin/users" class="inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out">
                        Cancel
                    </a>
                    <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out">
                        Reset Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
