<!-- Modal for adding user -->
<div id="add-user-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 transition-opacity duration-300 ease-out opacity-0 pointer-events-none">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-md overflow-hidden transition-all duration-300 ease-out transform scale-95 opacity-0">
        <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex justify-between items-center">
            <h3 class="text-lg font-semibold text-gray-800">Create New User</h3>
            <button id="close-add-user-modal" class="text-gray-400 hover:text-gray-600 focus:outline-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <form action="/users/create" method="POST" class="px-6 py-6 space-y-4">
            <div>
                <label for="name" class="block text-sm font-medium text-gray-700">Full Name *</label>
                <input type="text" id="name" name="name" value="<%= typeof values !== 'undefined' ? values.name || '' : '' %>" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
            </div>
            
            <div>
                <label for="email" class="block text-sm font-medium text-gray-700">Email *</label>
                <input type="email" id="email" name="email" value="<%= typeof values !== 'undefined' ? values.email || '' : '' %>" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
            </div>

            <div>
                <label for="phone" class="block text-sm font-medium text-gray-700">Phone</label>
                <input type="tel" id="phone" name="phone" value="<%= typeof values !== 'undefined' ? values.phone || '' : '' %>" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Roles *</label>
                <div class="mt-2 space-y-2">
                    <% Object.values(roles).forEach(role => { %>
                        <div class="flex items-center">
                            <input id="add-role-<%= role %>" name="roles" type="checkbox" value="<%= role %>" 
                                   <% if (typeof values !== 'undefined' && values.roles && values.roles.includes(role)) { %>checked<% } %>
                                   class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded">
                            <label for="add-role-<%= role %>" class="ml-3 block text-sm text-gray-900">
                                <%= role.charAt(0).toUpperCase() + role.slice(1) %>
                            </label>
                        </div>
                    <% }); %>
                </div>
                <p class="text-xs text-gray-500 mt-1">Select at least one role.</p>
            </div>

            <div>
                <label for="password" class="block text-sm font-medium text-gray-700">Password *</label>
                <input type="password" id="password" name="password" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                <p class="text-xs text-gray-500 mt-1">Minimum 6 characters</p>
            </div>

            <div>
                <label for="confirmPassword" class="block text-sm font-medium text-gray-700">Confirm Password *</label>
                <input type="password" id="confirmPassword" name="confirmPassword" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
            </div>

            <div class="pt-2">
                <button type="submit" class="w-full inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out">
                    Create User
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    const addUserModal = document.getElementById('add-user-modal');
    const addUserModalContent = addUserModal.querySelector('.bg-white');

    // Function to show the modal with animation
    window.showAddUserModal = function() {
        addUserModal.classList.remove('pointer-events-none');
        addUserModal.classList.remove('opacity-0');
        addUserModalContent.classList.remove('opacity-0', 'scale-95');
        addUserModalContent.classList.add('opacity-100', 'scale-100');
    }

    // Function to hide the modal with animation
    window.hideAddUserModal = function() {
        addUserModal.classList.add('opacity-0');
        addUserModalContent.classList.add('opacity-0', 'scale-95');
        addUserModalContent.classList.remove('opacity-100', 'scale-100');
        setTimeout(() => {
            addUserModal.classList.add('pointer-events-none');
        }, 300); // Match duration-300
    }

    // Update button listeners to use the new functions
    // The button with id 'add-user-button' is likely in index.ejs, 
    // it should be updated there to call showAddUserModal()
    // Example: <button id="add-user-button" onclick="showAddUserModal()">...</button>
    // If you cannot modify index.ejs, keep the original listener but call the new function:
    const addBtn = document.getElementById('add-user-button');
    if (addBtn) { // Check if the button exists on this page (it might be in index.ejs)
        addBtn.addEventListener('click', function(e) {
            e.preventDefault();
            window.showAddUserModal();
        });
    }

    document.getElementById('close-add-user-modal').addEventListener('click', window.hideAddUserModal);
    
    // Close modal on background click
    addUserModal.addEventListener('click', function(e) {
        if (e.target === this) {
            window.hideAddUserModal();
        }
    });
</script>