<% var success = typeof success !== 'undefined' ? success : null; %>
<% var error = typeof error !== 'undefined' ? error : null; %>
<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <%- include('../../partials/alerts', { success: success, error: error }) %>

    <!-- Page Header -->
    <div class="px-4 py-6 sm:px-0 mb-8">
        <h1 class="text-3xl font-bold leading-tight text-gray-900">
            Class Management
        </h1>
    </div>

    <!-- Main Content Card -->
    <div class="bg-white shadow-lg rounded-lg overflow-hidden border border-gray-200">
        <div class="px-6 py-5 bg-gray-50 border-b border-gray-200 flex justify-between items-center">
            <h2 class="text-xl font-semibold text-gray-800">All Classes</h2>
            <!-- Add New Class Button -->
            <button id="add-class-button" type="button" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out">
                <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
                Add New Class
            </button>
        </div>
        <div class="px-6 py-6">
            <% if (classes && classes.length > 0) { %>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="border-b border-gray-300">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Name</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Description</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Teacher</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <% classes.forEach(classObj => { %>
                                <tr class="hover:bg-gray-50 transition duration-150 ease-in-out">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= classObj.name %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= classObj.description || 'N/A' %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= classObj.teacherName || 'N/A' %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                        <div class="flex items-center space-x-2">
                                            <button
                                                type="button"
                                                class="view-class-button p-1.5 text-blue-600 hover:text-blue-800 hover:bg-blue-100 rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition duration-150 ease-in-out"
                                                data-id="<%= classObj._id %>"
                                                title="View Details">
                                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                            </button>
                                            <button
                                                type="button"
                                                class="manage-students-button p-1.5 text-green-600 hover:text-green-800 hover:bg-green-100 rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition duration-150 ease-in-out"
                                                data-id="<%= classObj._id %>"
                                                title="Manage Students">
                                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                                            </button>
                                            <a 
                                                href="/admin/classes/edit/<%= classObj._id %>" 
                                                class="p-1.5 text-yellow-600 hover:text-yellow-800 hover:bg-yellow-100 rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500 transition duration-150 ease-in-out"
                                                title="Edit Class">
                                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                            </a>
                                            <button 
                                                type="button" 
                                                class="delete-class-button p-1.5 text-red-600 hover:text-red-800 hover:bg-red-100 rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition duration-150 ease-in-out"
                                                onclick="window.showDeleteClassModal('<%= classObj._id %>', '<%= classObj.name %>')"
                                                title="Delete Class">
                                                <svg class="w-5 h-5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center py-12">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">No classes</h3>
                    <p class="mt-1 text-sm text-gray-500">Get started by creating a new class.</p>
                    <div class="mt-6">
                      <button id="add-class-button-empty" type="button" class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                          <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                        </svg>
                        Add New Class
                      </button>
                    </div>
                  </div>
            <% } %>
        </div>
    </div>

    <!-- Include modals -->
    <%- include('./add-class-modal') %>
    <%- include('./view-class-modal') %>
    <%- include('./manage-students-modal') %>
    <%- include('./delete-class-modal') %>
</div>

<script>
    // --- Add Class Modal --- 
    // Ensure both add buttons trigger the modal
    document.getElementById('add-class-button')?.addEventListener('click', () => {
        // Assuming showAddClassModal is defined in add-class-modal.ejs or globally
        if(typeof showAddClassModal === 'function') showAddClassModal(); 
    });
    document.getElementById('add-class-button-empty')?.addEventListener('click', () => {
        if(typeof showAddClassModal === 'function') showAddClassModal();
    });

    // --- Edit Class Modal --- (Removed - Handled by separate page now)
    /*
    document.querySelectorAll('.edit-class-button').forEach(button => {
        button.addEventListener('click', function() {
            const classId = this.dataset.id;
            const className = this.dataset.name;
            const classDescription = this.dataset.description;
            const teacherId = this.dataset.teacherId;
            if(typeof showEditClassModal === 'function') {
                showEditClassModal(classId, className, classDescription, teacherId);
            }
        });
    });
    */

    // --- View Class Modal --- 
    // Assuming openViewModal is defined in view-class-modal.ejs
    document.querySelectorAll('.view-class-button').forEach(button => {
        button.addEventListener('click', function() {
            const classId = this.dataset.id;
            if(typeof openViewModal === 'function') {
                openViewModal(classId);
            }
        });
    });

    // --- Manage Students Modal --- 
    // Assuming openManageModal is defined in manage-students-modal.ejs
    document.querySelectorAll('.manage-students-button').forEach(button => {
        button.addEventListener('click', function() {
            const classId = this.dataset.id;
            if(typeof openManageModal === 'function') {
                openManageModal(classId);
            }
        });
    });

    // --- Delete Class Modal --- (Handled by onclick)
</script>