<% var classObj = typeof classObj !== 'undefined' ? classObj : {}; %>
<% var enrolledStudents = typeof enrolledStudents !== 'undefined' ? enrolledStudents : []; // Assume this is passed now %>
<% var error = typeof error !== 'undefined' ? error : null; %>
<% var success = typeof success !== 'undefined' ? success : null; %>

<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <%- include('../../partials/alerts', { success: success, error: error }) %>

    <!-- Page Header -->
    <div class="px-4 py-6 sm:px-0 mb-8">
        <h1 class="text-3xl font-bold leading-tight text-gray-900">
            Manage Students for <%= classObj.name %>
        </h1>
    </div>

    <!-- Main Content Card -->
    <div class="bg-white shadow-lg rounded-lg overflow-hidden border border-gray-200">
        <div class="px-6 py-5 bg-gray-50 border-b border-gray-200">
            <h2 class="text-xl font-semibold text-gray-800">Enrolled Students</h2>
        </div>
        <div class="px-6 py-6">
            <% if (enrolledStudents && enrolledStudents.length > 0) { %>
                <div class="overflow-x-auto mb-6">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="border-b border-gray-300">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Name</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <% enrolledStudents.forEach(student => { %>
                                <tr class="hover:bg-gray-50 transition duration-150 ease-in-out" id="student-row-<%= student._id %>">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= student.name %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                        <!-- Removed form, added onclick handler -->
                                        <button
                                            type="button"
                                            onclick="showUnenrollModal('<%= classObj._id %>', '<%= student._id %>', '<%= student.name %>')"
                                            class="p-1.5 text-red-600 hover:text-red-800 hover:bg-red-100 rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition duration-150 ease-in-out"
                                            title="Unenroll Student">
                                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                        </button>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p class="mt-1 mb-6 text-gray-500 italic">No students are currently enrolled in this class.</p>
            <% } %>

            <hr class="my-6 border-gray-200">

            <!-- Enroll New Students Section -->
            <div>
                <h3 class="text-lg font-medium text-gray-900 mb-4">Enroll New Students</h3>
                <form action="/admin/classes/<%= classObj._id %>/students" method="POST" class="space-y-4" id="enroll-student-form">
                    <div>
                        <label for="student-search" class="block text-sm font-medium text-gray-700 mb-1">Search for student to enroll:</label>
                        <div class="relative">
                            <input type="text" id="student-search" name="studentSearch" placeholder="Start typing student name..." class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                            <!-- Search results container -->
                            <div id="search-results" class="absolute z-10 mt-1 w-full bg-white border border-gray-300 rounded-md shadow-lg max-h-60 overflow-y-auto hidden"></div>
                        </div>
                        <input type="hidden" name="studentId" id="selected-student-id">
                    </div>

                    <div class="pt-4 flex justify-end space-x-3">
                         <a href="/admin/classes" class="inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out">
                            Cancel
                        </a>
                        <button type="submit" id="enroll-button" disabled class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out disabled:opacity-50 disabled:cursor-not-allowed">
                            Enroll Selected Student
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Unenroll Student Confirmation Modal -->
<div id="unenroll-student-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 transition-opacity duration-300 ease-out opacity-0 pointer-events-none">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-md overflow-hidden transition-all duration-300 ease-out transform scale-95 opacity-0">
        <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex justify-between items-center">
            <h3 class="text-lg font-semibold text-red-700">Confirm Unenrollment</h3>
            <button id="close-unenroll-modal" class="text-gray-400 hover:text-gray-600 focus:outline-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div class="px-6 py-6 space-y-4">
            <p class="text-sm text-gray-700">Are you sure you want to unenroll student: <strong id="unenroll-student-name"></strong> from this class?</p>

            <div class="pt-2 flex justify-end space-x-3">
                 <button type="button" id="cancel-unenroll-modal" class="py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out">
                    Cancel
                </button>
                <button type="button" id="confirm-unenroll-button" data-class-id="" data-student-id="" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition duration-150 ease-in-out">
                    Unenroll Student
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Basic JavaScript for student search (needs backend endpoint)
    const searchInput = document.getElementById('student-search');
    const resultsContainer = document.getElementById('search-results');
    const selectedStudentIdInput = document.getElementById('selected-student-id');
    const enrollButton = document.getElementById('enroll-button');
    const classId = '<%= classObj._id %>'; // Get class ID from EJS

    let searchTimeout;

    searchInput.addEventListener('input', () => {
        clearTimeout(searchTimeout);
        const query = searchInput.value.trim();
        resultsContainer.innerHTML = ''; // Clear previous results
        selectedStudentIdInput.value = ''; // Clear selection
        enrollButton.disabled = true; // Disable button

        if (query.length < 2) { // Don't search for very short strings
            return;
        }

        resultsContainer.innerHTML = '<div class="p-2 text-sm text-gray-500">Searching...</div>'; // Loading indicator

        searchTimeout = setTimeout(() => {
            // Replace with your actual API endpoint for searching students
            // This endpoint should probably exclude already enrolled students for this class
            fetch(`/admin/students/api/search?q=${encodeURIComponent(query)}&excludeClassId=${classId}`)
                .then(response => response.json())
                .then(students => {
                    resultsContainer.innerHTML = ''; // Clear loading/previous
                    if (students.length > 0) {
                        students.forEach(student => {
                            const div = document.createElement('div');
                            // Apply Tailwind classes for styling
                            div.classList.add(
                                'px-3', 
                                'py-2', 
                                'text-sm', 
                                'text-gray-700', 
                                'hover:bg-indigo-100', 
                                'hover:text-indigo-900', 
                                'cursor-pointer', 
                                'border-b', // Add bottom border to each item
                                'border-gray-200', 
                                'last:border-b-0' // Remove border from the last item
                            );
                            div.textContent = student.name; 
                            div.dataset.studentId = student._id; 
                            div.addEventListener('click', () => {
                                // Highlight selection (optional, using a different background)
                                Array.from(resultsContainer.children).forEach(child => child.classList.remove('bg-indigo-200', 'font-semibold'));
                                div.classList.add('bg-indigo-200', 'font-semibold');

                                // Set hidden input value and enable button
                                selectedStudentIdInput.value = student._id;
                                searchInput.value = student.name; 
                                resultsContainer.classList.add('hidden'); // Hide results after selection
                                resultsContainer.innerHTML = ''; 
                                enrollButton.disabled = false;
                            });
                            resultsContainer.appendChild(div);
                        });
                        resultsContainer.classList.remove('hidden'); // Show results container
                    } else {
                        resultsContainer.innerHTML = '<div class="px-3 py-2 text-sm text-gray-500 italic">No matching students found.</div>';
                        resultsContainer.classList.remove('hidden'); // Show no results message
                    }
                })
                .catch(error => {
                    console.error('Error fetching students:', error);
                    resultsContainer.innerHTML = '<div class="px-3 py-2 text-sm text-red-600">Error searching students.</div>';
                    resultsContainer.classList.remove('hidden'); // Show error message
                });
        }, 300); // Debounce search requests
    });

    // Hide results if input is cleared or loses focus without selection
    searchInput.addEventListener('blur', () => {
        setTimeout(() => {
            // Check if the focus moved to an element within the results container
            if (!resultsContainer.contains(document.activeElement)) {
                 resultsContainer.classList.add('hidden');
                 // Optionally clear the input if no selection was made and it doesn't match a selected name
                 // This part might need refinement based on desired UX
                 if (!selectedStudentIdInput.value) {
                     // searchInput.value = ''; // Uncomment to clear input on blur if nothing selected
                 }
            }
        }, 150); // Delay to allow click event on results
    });

    // Show results when input is focused and has content
    searchInput.addEventListener('focus', () => {
        if (searchInput.value.trim().length >= 2 && resultsContainer.children.length > 0) {
            resultsContainer.classList.remove('hidden');
        }
    });

</script>

<!-- Script for handling the unenroll modal and action -->
<script>
    const unenrollModal = document.getElementById('unenroll-student-modal');
    const unenrollModalContent = unenrollModal.querySelector('.bg-white');
    const unenrollStudentNameSpan = document.getElementById('unenroll-student-name');
    const confirmUnenrollButton = document.getElementById('confirm-unenroll-button');

    // Function to show the modal with animation and populate data
    window.showUnenrollModal = function(classId, studentId, studentName) {
        // Set student name in confirmation message
        unenrollStudentNameSpan.textContent = studentName;

        // Store IDs on the confirm button
        confirmUnenrollButton.dataset.classId = classId;
        confirmUnenrollButton.dataset.studentId = studentId;

        // Show modal with animation
        unenrollModal.classList.remove('pointer-events-none');
        unenrollModal.classList.remove('opacity-0');
        unenrollModalContent.classList.remove('opacity-0', 'scale-95');
        unenrollModalContent.classList.add('opacity-100', 'scale-100');
    }

    // Function to hide the modal with animation
    window.hideUnenrollModal = function() {
        unenrollModal.classList.add('opacity-0');
        unenrollModalContent.classList.add('opacity-0', 'scale-95');
        unenrollModalContent.classList.remove('opacity-100', 'scale-100');
        setTimeout(() => {
            unenrollModal.classList.add('pointer-events-none');
            // Clear data attributes when hiding
            confirmUnenrollButton.dataset.classId = '';
            confirmUnenrollButton.dataset.studentId = '';
            unenrollStudentNameSpan.textContent = '';
        }, 300); // Match duration-300
    }

    // Function to perform the unenroll action
    function confirmUnenroll() {
        const classId = confirmUnenrollButton.dataset.classId;
        const studentId = confirmUnenrollButton.dataset.studentId;

        if (!classId || !studentId) {
            console.error('Missing classId or studentId for unenrollment.');
            // Optionally show an error to the user here
            hideUnenrollModal(); // Hide modal even if there's an error
            return;
        }

        fetch(`/admin/classes/${classId}/students/${studentId}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => {
            // Always reload the page. The server should set a flash message
            // (success or error) which will be displayed by the alerts partial.
            window.location.reload();
        })
        .catch(error => {
            console.error('Network error unenrolling student:', error);
            // Still reload the page. The user will see a generic error if the server
            // couldn't be reached, or the server-set flash message if the request
            // went through but resulted in an error handled server-side.
            window.location.reload();
        });
        // Hide the modal immediately after initiating the fetch
        hideUnenrollModal();
    }


    // Event listeners for modal controls
    document.getElementById('close-unenroll-modal').addEventListener('click', window.hideUnenrollModal);
    document.getElementById('cancel-unenroll-modal').addEventListener('click', window.hideUnenrollModal);
    confirmUnenrollButton.addEventListener('click', confirmUnenroll);

    // Close modal on background click
    unenrollModal.addEventListener('click', function(e) {
        if (e.target === this) {
            window.hideUnenrollModal();
        }
    });

    // Remove the old unenrollStudent function if it exists
    // (This replaces the previous script block entirely)
    /*
    function unenrollStudent(classId, studentId) {
        // Old function removed - now handled by modal
    }
    */
</script>
