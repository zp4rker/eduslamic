<!-- views/admin/classes/view-class-modal.ejs -->
<div id="view-class-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 transition-opacity duration-300 ease-out opacity-0 pointer-events-none">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-2xl overflow-hidden transition-all duration-300 ease-out transform scale-95 opacity-0">
        <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex justify-between items-center">
            <h3 class="text-lg font-semibold text-gray-800" id="view-class-modal-title">Class Details</h3>
            <button id="close-view-class-modal" class="text-gray-400 hover:text-gray-600 focus:outline-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div id="view-class-modal-content" class="px-6 py-6">
            <!-- Loading state -->
            <div id="view-class-loading" class="text-center py-4">Loading...</div>
            <!-- Error state -->
            <div id="view-class-error" class="hidden text-red-600 py-4"></div>
            <!-- Content -->
            <div id="view-class-details" class="hidden">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Name:</label>
                    <p class="mt-1 text-lg text-gray-900" id="view-class-name"></p>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Description:</label>
                    <p class="mt-1 text-gray-600" id="view-class-description"></p>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Teacher:</label>
                    <p class="mt-1 text-gray-600" id="view-class-teacher"></p>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Enrolled Students:</label>
                    <ul id="view-class-students-list" class="mt-1 list-disc list-inside text-gray-600">
                        <!-- Student names will be populated here -->
                    </ul>
                    <p id="view-class-no-students" class="mt-1 text-gray-500 italic hidden">No students enrolled in this class.</p>
                </div>
            </div>
        </div>
        <div class="px-6 pb-4 pt-4 bg-gray-50 border-t border-gray-200 flex justify-end">
            <button type="button" class="px-4 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300" onclick="closeViewModal()">Close</button>
        </div>
    </div>
</div>

<script>
    const viewModal = document.getElementById('view-class-modal');
    const viewModalContentDiv = viewModal.querySelector('.bg-white'); // Target the inner div for animation
    const viewModalTitle = document.getElementById('view-class-modal-title');
    const viewLoading = document.getElementById('view-class-loading');
    const viewError = document.getElementById('view-class-error');
    const viewDetails = document.getElementById('view-class-details');
    const viewClassName = document.getElementById('view-class-name');
    const viewClassDescription = document.getElementById('view-class-description');
    const viewClassTeacher = document.getElementById('view-class-teacher');
    const viewStudentsList = document.getElementById('view-class-students-list');
    const viewNoStudents = document.getElementById('view-class-no-students');

    function closeViewModal() {
        viewModal.classList.add('opacity-0');
        viewModalContentDiv.classList.add('opacity-0', 'scale-95');
        viewModalContentDiv.classList.remove('opacity-100', 'scale-100');
        setTimeout(() => {
            viewModal.classList.add('pointer-events-none');
            // Reset state after animation
            viewLoading.style.display = 'block';
            viewError.classList.add('hidden');
            viewError.textContent = '';
            viewDetails.classList.add('hidden');
            viewStudentsList.innerHTML = ''; // Clear student list
            viewNoStudents.classList.add('hidden');
        }, 300); // Match duration-300
    }

    async function openViewModal(classId) {
        // Reset state before showing
        viewLoading.style.display = 'block';
        viewError.classList.add('hidden');
        viewError.textContent = '';
        viewDetails.classList.add('hidden');
        viewStudentsList.innerHTML = '';
        viewNoStudents.classList.add('hidden');

        // Show modal with animation
        viewModal.classList.remove('pointer-events-none');
        viewModal.classList.remove('opacity-0');
        viewModalContentDiv.classList.remove('opacity-0', 'scale-95');
        viewModalContentDiv.classList.add('opacity-100', 'scale-100');

        try {
            const response = await fetch(`/admin/classes/api/details/${classId}`);
            if (!response.ok) {
                const errorData = await response.json();
                throw new Error(errorData.error || `HTTP error! status: ${response.status}`);
            }
            const data = await response.json();
            const { classObj, students } = data;

            // Populate modal
            viewModalTitle.textContent = `Details for ${classObj.name}`;
            viewClassName.textContent = classObj.name;
            viewClassDescription.textContent = classObj.description || 'N/A';
            viewClassTeacher.textContent = classObj.teacherName || 'Not Assigned';

            viewStudentsList.innerHTML = ''; // Clear previous list
            if (students && students.length > 0) {
                students.forEach(student => {
                    const li = document.createElement('li');
                    li.textContent = student.name; // Assuming student object has a 'name' property
                    viewStudentsList.appendChild(li);
                });
                viewNoStudents.classList.add('hidden');
            } else {
                viewNoStudents.classList.remove('hidden');
            }

            viewLoading.style.display = 'none';
            viewDetails.classList.remove('hidden');

        } catch (error) {
            console.error('Error fetching class details:', error);
            viewLoading.style.display = 'none';
            viewError.textContent = `Error loading details: ${error.message}`;
            viewError.classList.remove('hidden');
        }
    }

    // Add ID to the close button if it doesn't have one, or use the existing one
    document.getElementById('close-view-class-modal').addEventListener('click', closeViewModal);

    // Close modal if clicking outside of it
    viewModal.addEventListener('click', (event) => {
        // Check if the click is on the backdrop itself, not the content
        if (event.target === viewModal) {
            closeViewModal();
        }
    });
</script>