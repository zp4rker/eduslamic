<!-- Modal for editing class -->
<div id="edit-class-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 transition-opacity duration-300 ease-out opacity-0 pointer-events-none">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-lg overflow-hidden transition-all duration-300 ease-out transform scale-95 opacity-0">
        <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex justify-between items-center">
            <h3 class="text-lg font-semibold text-gray-800">Edit Class: <span id="edit-class-title"></span></h3>
            <button id="close-edit-class-modal" class="text-gray-400 hover:text-gray-600 focus:outline-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <!-- Class edit form -->
        <form id="edit-class-form" action="" method="POST" class="px-6 py-6 space-y-4">
            <div>
                <label for="edit-name" class="block text-sm font-medium text-gray-700">Class Name *</label>
                <input type="text" id="edit-name" name="name" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
            </div>
            <div>
                <label for="edit-description" class="block text-sm font-medium text-gray-700">Description</label>
                <textarea id="edit-description" name="description" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm resize-vertical h-24"></textarea>
            </div>
            <div>
                <label for="edit-teacher" class="block text-sm font-medium text-gray-700">Teacher</label>
                <select id="edit-teacher" name="teacherId" class="mt-1 block w-full px-3 py-2 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                    <option value="">Select Teacher</option>
                    <% if (typeof teachers !== 'undefined' && teachers.length > 0) { %>
                        <% teachers.forEach(teacher => { %>
                            <option value="<%= teacher._id %>">
                                <%= teacher.name %> (<%= teacher.email %>)
                            </option>
                        <% }); %>
                    <% } %>
                </select>
            </div>
            <div class="pt-2">
                <button type="submit" class="w-full inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out">
                    Update Class
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    const editClassModal = document.getElementById('edit-class-modal');
    const editClassModalContent = editClassModal.querySelector('.bg-white');
    const editClassForm = document.getElementById('edit-class-form');
    const editClassTitle = document.getElementById('edit-class-title');
    const editNameInput = document.getElementById('edit-name');
    const editDescriptionInput = document.getElementById('edit-description');
    const editTeacherSelect = document.getElementById('edit-teacher');

    function showEditClassModal(classId, className, description, teacherId) {
        // Set form action URL
        editClassForm.action = `/admin/classes/edit/${classId}`; // Corrected path

        // Fill form fields
        editClassTitle.textContent = className;
        editNameInput.value = className;
        editDescriptionInput.value = description;

        // Set teacher dropdown
        for (let i = 0; i < editTeacherSelect.options.length; i++) {
            editTeacherSelect.options[i].selected = (editTeacherSelect.options[i].value === teacherId);
        }

        // Show modal with animation
        editClassModal.classList.remove('pointer-events-none');
        editClassModal.classList.remove('opacity-0');
        editClassModalContent.classList.remove('opacity-0', 'scale-95');
        editClassModalContent.classList.add('opacity-100', 'scale-100');
    }

    function hideEditClassModal() {
        editClassModal.classList.add('opacity-0');
        editClassModalContent.classList.add('opacity-0', 'scale-95');
        editClassModalContent.classList.remove('opacity-100', 'scale-100');
        // Wait for animation to finish before disabling pointer events
        setTimeout(() => {
            editClassModal.classList.add('pointer-events-none');
        }, 300); // Match duration-300
    }

    // Attach event listeners to edit buttons (assuming they are in index.ejs or similar)
    const editButtons = document.querySelectorAll('.edit-class-button');
    editButtons.forEach(button => {
        button.addEventListener('click', function() {
            const classId = this.getAttribute('data-id');
            const className = this.getAttribute('data-name');
            const description = this.getAttribute('data-description');
            const teacherId = this.getAttribute('data-teacher-id');

            showEditClassModal(classId, className, description, teacherId);
        });
    });

    // Event listener for close button
    document.getElementById('close-edit-class-modal').addEventListener('click', hideEditClassModal);

    // Close edit modal on background click
    editClassModal.addEventListener('click', function(e) {
        if (e.target === this) {
            hideEditClassModal();
        }
    });
</script>