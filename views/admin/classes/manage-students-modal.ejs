<!-- views/admin/classes/manage-students-modal.ejs -->
<div id="manage-students-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 transition-opacity duration-300 ease-out opacity-0 pointer-events-none">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-lg overflow-hidden transition-all duration-300 ease-out transform scale-95 opacity-0">
        <form id="manage-students-form" method="POST"> <!-- Action will be set dynamically -->
            <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex justify-between items-center">
                <h3 class="text-lg font-semibold text-gray-800" id="manage-students-modal-title">Manage Students</h3>
                <button id="close-manage-students-modal" type="button" class="text-gray-400 hover:text-gray-600 focus:outline-none">
                     <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div id="manage-students-modal-content" class="px-6 py-6">
                <!-- Loading state -->
                <div id="manage-students-loading" class="text-center py-4">Loading...</div>
                <!-- Error state -->
                <div id="manage-students-error" class="hidden text-red-600 py-4"></div>
                <!-- Content -->
                <div id="manage-students-list-container" class="hidden max-h-60 overflow-y-auto mb-4 border rounded p-3">
                    <p class="text-sm text-gray-600 mb-2">Select students to enroll in this class:</p>
                    <div id="manage-students-list">
                        <!-- Checkboxes will be populated here -->
                    </div>
                    <p id="manage-students-no-students" class="mt-1 text-gray-500 italic hidden">No students available to enroll.</p>
                </div>
            </div>
            <div class="px-6 pb-4 pt-4 bg-gray-50 border-t border-gray-200 flex justify-end space-x-2">
                <button type="button" class="px-4 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300" onclick="closeManageModal()">Cancel</button>
                <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<script>
    const manageModal = document.getElementById('manage-students-modal');
    const manageModalContentDiv = manageModal.querySelector('.bg-white'); // Target the inner div for animation
    const manageModalTitle = document.getElementById('manage-students-modal-title');
    const manageForm = document.getElementById('manage-students-form');
    const manageLoading = document.getElementById('manage-students-loading');
    const manageError = document.getElementById('manage-students-error');
    const manageListContainer = document.getElementById('manage-students-list-container');
    const manageStudentsList = document.getElementById('manage-students-list');
    const manageNoStudents = document.getElementById('manage-students-no-students');

    function closeManageModal() {
        manageModal.classList.add('opacity-0');
        manageModalContentDiv.classList.add('opacity-0', 'scale-95');
        manageModalContentDiv.classList.remove('opacity-100', 'scale-100');
        setTimeout(() => {
            manageModal.classList.add('pointer-events-none');
            // Reset state after animation
            manageLoading.style.display = 'block';
            manageError.classList.add('hidden');
            manageError.textContent = '';
            manageListContainer.classList.add('hidden');
            manageStudentsList.innerHTML = ''; // Clear student list
            manageNoStudents.classList.add('hidden');
            manageForm.action = ''; // Clear form action
        }, 300); // Match duration-300
    }

    async function openManageModal(classId) {
        // Reset state before showing
        manageLoading.style.display = 'block';
        manageError.classList.add('hidden');
        manageError.textContent = '';
        manageListContainer.classList.add('hidden');
        manageStudentsList.innerHTML = '';
        manageNoStudents.classList.add('hidden');
        manageForm.action = `/admin/classes/${classId}/students`; // Set form action

        // Show modal with animation
        manageModal.classList.remove('pointer-events-none');
        manageModal.classList.remove('opacity-0');
        manageModalContentDiv.classList.remove('opacity-0', 'scale-95');
        manageModalContentDiv.classList.add('opacity-100', 'scale-100');

        try {
            const response = await fetch(`/admin/classes/api/manage/${classId}`);
            if (!response.ok) {
                const errorData = await response.json();
                throw new Error(errorData.error || `HTTP error! status: ${response.status}`);
            }
            const data = await response.json();
            const { classObj, allStudents, enrolledStudentIds } = data;

            // Populate modal
            manageModalTitle.textContent = `Manage Students for ${classObj.name}`;
            manageStudentsList.innerHTML = ''; // Clear previous list

            if (allStudents && allStudents.length > 0) {
                allStudents.forEach(student => {
                    const isEnrolled = enrolledStudentIds.includes(student._id);
                    const div = document.createElement('div');
                    div.classList.add('flex', 'items-center', 'mb-1');

                    const checkbox = document.createElement('input');
                    checkbox.type = 'checkbox';
                    checkbox.id = `student-${student._id}`;
                    checkbox.name = 'studentIds';
                    checkbox.value = student._id;
                    checkbox.checked = isEnrolled;
                    checkbox.classList.add('h-4', 'w-4', 'text-indigo-600', 'border-gray-300', 'rounded', 'focus:ring-indigo-500');

                    const label = document.createElement('label');
                    label.htmlFor = `student-${student._id}`;
                    label.textContent = student.name; // Assuming student object has a 'name' property
                    label.classList.add('ml-2', 'block', 'text-sm', 'text-gray-900');

                    div.appendChild(checkbox);
                    div.appendChild(label);
                    manageStudentsList.appendChild(div);
                });
                manageNoStudents.classList.add('hidden');
            } else {
                manageNoStudents.classList.remove('hidden');
            }

            manageLoading.style.display = 'none';
            manageListContainer.classList.remove('hidden');

        } catch (error) {
            console.error('Error fetching data for manage students modal:', error);
            manageLoading.style.display = 'none';
            manageError.textContent = `Error loading student data: ${error.message}`;
            manageError.classList.remove('hidden');
        }
    }

    // Add ID to the close button if it doesn't have one, or use the existing one
    document.getElementById('close-manage-students-modal').addEventListener('click', closeManageModal);

    // Close modal if clicking outside of it
    manageModal.addEventListener('click', (event) => {
        // Check if the click is on the backdrop itself, not the content
        if (event.target === manageModal) {
            closeManageModal();
        }
    });
</script>