<!-- Modal for editing student -->
<div id="edit-student-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 hidden">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-lg overflow-hidden">
        <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex justify-between items-center">
            <h3 class="text-lg font-semibold text-gray-800">Edit Student: <span id="edit-student-title"></span></h3>
            <button id="close-edit-student-modal" class="text-gray-400 hover:text-gray-600 focus:outline-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <!-- Student edit form -->
        <form id="edit-student-form" action="" method="POST" class="px-6 py-6 space-y-4">
            <div>
                <label for="edit-name" class="block text-sm font-medium text-gray-700">Full Name *</label>
                <input type="text" id="edit-name" name="name" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
            </div>
            
            <div>
                <label for="edit-dateOfBirth" class="block text-sm font-medium text-gray-700">Date of Birth *</label>
                <input type="date" id="edit-dateOfBirth" name="dateOfBirth" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
            </div>

            <div>
                <label for="edit-parentIds" class="block text-sm font-medium text-gray-700">Assign Parent(s)</label>
                <select multiple id="edit-parentIds" name="parentIds" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm h-32">
                    <% if (typeof parents !== 'undefined' && parents.length > 0) { %>
                        <% parents.forEach(parent => { %>
                            <option value="<%= parent._id %>"><%= parent.name %> (<%= parent.email %>)</option>
                        <% }); %>
                    <% } else { %>
                        <option disabled>No parents available</option>
                    <% } %>
                </select>
                <p class="text-sm text-gray-500 mt-1">Hold Ctrl/Cmd to select multiple parents.</p>
            </div>

            <div class="pt-2">
                <button type="submit" class="w-full inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out">
                    Update Student
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    // Edit student functionality
    const editButtons = document.querySelectorAll('.edit-student-button');
    editButtons.forEach(button => {
        button.addEventListener('click', function() {
            const studentId = this.getAttribute('data-id');
            const studentName = this.getAttribute('data-name');
            const dob = this.getAttribute('data-dob');

            // Set form action URL
            document.getElementById('edit-student-form').action = `/students/edit/${studentId}`;
            
            // Fill form fields
            document.getElementById('edit-student-title').textContent = studentName;
            document.getElementById('edit-name').value = studentName;
            document.getElementById('edit-dateOfBirth').value = dob;
            
            // Show modal
            document.getElementById('edit-student-modal').classList.remove('hidden');
            
            // Get the current parent ids for this student (if available)
            // This requires an API call or server-side data since we don't have parent data attached to the button
            // For now we'll leave the parents multi-select as is - you may want to add this functionality later
        });
    });

    document.getElementById('close-edit-student-modal').addEventListener('click', function() {
        document.getElementById('edit-student-modal').classList.add('hidden');
    });

    // Close edit modal on background click
    document.getElementById('edit-student-modal').addEventListener('click', function(e) {
        if (e.target === this) {
            this.classList.add('hidden');
        }
    });
</script>