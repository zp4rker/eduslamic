<!-- Modal for adding student -->
<div id="add-student-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 transition-opacity duration-300 ease-out opacity-0 pointer-events-none">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-lg overflow-hidden transition-all duration-300 ease-out transform scale-95 opacity-0">
        <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex justify-between items-center">
            <h3 class="text-lg font-semibold text-gray-800">Create New Student</h3>
            <button id="close-add-student-modal" class="text-gray-400 hover:text-gray-600 focus:outline-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <form action="/admin/students/create" method="POST" class="px-6 py-6 space-y-4">
            <div>
                <label for="name" class="block text-sm font-medium text-gray-700">Full Name *</label>
                <input type="text" id="name" name="name" value="<%= typeof values !== 'undefined' ? values.name || '' : '' %>" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
            </div>
            
            <div>
                <label for="dateOfBirth" class="block text-sm font-medium text-gray-700">Date of Birth *</label>
                <input type="date" id="dateOfBirth" name="dateOfBirth" value="<%= typeof values !== 'undefined' ? values.dateOfBirth || '' : '' %>" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
            </div>

            <div>
                <label for="parentIds" class="block text-sm font-medium text-gray-700">Assign Parent(s)</label>
                <select multiple id="parentIds" name="parentIds" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm h-32">
                    <% if (typeof parents !== 'undefined' && parents.length > 0) { %>
                        <% parents.forEach(parent => { %>
                            <option value="<%= parent._id %>"><%= parent.name %> (<%= parent.email %>)</option>
                        <% }); %>
                    <% } else { %>
                        <option disabled>No parents available</option>
                    <% } %>
                </select>
                <p class="text-sm text-gray-500 mt-1">Hold Ctrl/Cmd to select multiple parents.</p>
            </div>

            <div class="pt-2">
                <button type="submit" class="w-full inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out">
                    Create Student
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    const addModal = document.getElementById('add-student-modal');
    const addModalContent = addModal.querySelector('.bg-white'); // Target the inner content div

    // Attach to window object
    window.showAddStudentModal = function() {
        addModal.classList.remove('pointer-events-none');
        addModal.classList.remove('opacity-0');
        addModalContent.classList.remove('opacity-0', 'scale-95');
        addModalContent.classList.add('opacity-100', 'scale-100'); // Add final states for content
    }

    // Attach to window object
    window.hideAddStudentModal = function() {
        addModal.classList.add('opacity-0');
        addModalContent.classList.add('opacity-0', 'scale-95');
        addModalContent.classList.remove('opacity-100', 'scale-100'); // Remove final states for content
        // Wait for animation to finish before disabling pointer events
        setTimeout(() => {
            addModal.classList.add('pointer-events-none');
        }, 300); // Match duration-300
    }

    // Keep original event listeners, but call the new functions
    document.getElementById('close-add-student-modal').addEventListener('click', window.hideAddStudentModal);

    // Optional: Close modal on background click
    addModal.addEventListener('click', function(e) {
        if (e.target === this) {
            window.hideAddStudentModal();
        }
    });

    // No need to expose globally anymore as they are attached to window
</script>