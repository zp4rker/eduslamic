<% var success = typeof success !== 'undefined' ? success : null; %>
<% var error = typeof error !== 'undefined' ? error : null; %>
<% var values = typeof values !== 'undefined' ? values : {}; %>
<% var student = typeof student !== 'undefined' ? student : {}; %>
<% var parents = typeof parents !== 'undefined' ? parents : []; %>
<% var assignedParentIds = typeof assignedParentIds !== 'undefined' ? assignedParentIds : []; %>

<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <%- include('../../partials/alerts', { success: success, error: error }) %>

    <!-- Page Header -->
    <div class="px-4 py-6 sm:px-0 mb-8">
        <div class="flex justify-between items-center">
            <h1 class="text-3xl font-bold leading-tight text-gray-900">
                Edit Student: <%= student.name %>
            </h1>
            <!-- Removed Back to Students button -->
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="bg-white shadow-lg rounded-lg overflow-hidden border border-gray-200">
        <div class="px-6 py-5 bg-gray-50 border-b border-gray-200">
            <h2 class="text-xl font-semibold text-gray-800">Student Details</h2>
        </div>
        <form action="/admin/students/edit/<%= student._id %>" method="POST" class="px-6 py-6 space-y-4">
            <div>
                <label for="name" class="block text-sm font-medium text-gray-700">Full Name *</label>
                <input type="text" id="name" name="name" value="<%= values.name || student.name || '' %>" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
            </div>

            <div>
                <label for="dateOfBirth" class="block text-sm font-medium text-gray-700">Date of Birth *</label>
                <%
                    let dobValue = '';
                    if (values.dateOfBirth) {
                        dobValue = values.dateOfBirth;
                    } else if (student.dateOfBirth) {
                        try {
                            dobValue = new Date(student.dateOfBirth).toISOString().split('T')[0];
                        } catch (e) {
                            // Handle potential invalid date format if necessary
                        }
                    }
                %>
                <input type="date" id="dateOfBirth" name="dateOfBirth" value="<%= dobValue %>" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
            </div>

            <div>
                <label for="parentIds" class="block text-sm font-medium text-gray-700">Assign Parent(s)</label>
                <!-- Removed Tailwind classes like border, shadow, focus rings as Tagify container handles styling -->
                <input id="parentIds" name="parentIds" value="" class="mt-1 block w-full">
                <p class="text-sm text-gray-500 mt-1">Type to search and select parents.</p>
            </div>

            <div class="pt-2 flex justify-end space-x-3">
                <a href="/admin/students" class="inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out">
                    Cancel
                </a>
                <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out">
                    Update Student
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Add Tagify CSS and JS -->
<link href="https://cdn.jsdelivr.net/npm/@yaireo/tagify/dist/tagify.css" rel="stylesheet" type="text/css" />
<script src="https://cdn.jsdelivr.net/npm/@yaireo/tagify/dist/tagify.min.js"></script>

<script>
    // Prepare data for Tagify
    const parentsData = <%- JSON.stringify(parents.map(p => ({ value: p._id.toString(), name: `${p.name} (${p.email})` }))) %>;
    const assignedParentIdsData = <%- JSON.stringify(assignedParentIds) %>;

    // Find the full parent objects for the initially assigned IDs
    const initialTags = assignedParentIdsData
        .map(id => parentsData.find(p => p.value === id))
        .filter(p => p); // Filter out any potential nulls if an ID doesn't match

    // Get the input element
    const input = document.getElementById('parentIds');

    // Initialize Tagify
    const tagify = new Tagify(input, {
        tagTextProp: 'name', // <-- Add this line to display the 'name' property
        whitelist: parentsData, // List of allowed tags
        originalInputValueFormat: valuesArr => valuesArr.map(item => item.value).join(','), // Submit comma-separated IDs
        dropdown: {
            mapValueTo: 'name', // <-- Add this to display 'name' in suggestions
            maxItems: 10,           // Max items shown in dropdown
            classname: "tags-look", // Optional: Classname for dropdown
            enabled: 0,             // Start without showing dropdown
            closeOnSelect: false    // Keep dropdown open after selection
        },
        enforceWhitelist: true // Only allow tags from the whitelist
    });

    // Set initial value
    tagify.addTags(initialTags);

    // Optional: Add event listener if needed for debugging or complex logic
    // tagify.on('change', function(e){
    //     console.log('Tagify changed:', e.detail.value);
    //     // The input's value is automatically updated by Tagify based on originalInputValueFormat
    // });

    // Ensure the input value is correctly set on form submission
    // Tagify handles updating the original input's value based on the 'originalInputValueFormat' setting.
    // If submitting as JSON was preferred, the format would be:
    // originalInputValueFormat: valuesArr => JSON.stringify(valuesArr.map(item => item.value))
    // And the server-side would need to parse JSON.
    // Using comma-separated is often simpler if the server expects a string or can easily split it.

</script>
