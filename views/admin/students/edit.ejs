<% var success = typeof success !== 'undefined' ? success : null; %>
<% var error = typeof error !== 'undefined' ? error : null; %>
<% var values = typeof values !== 'undefined' ? values : {}; %>
<% var student = typeof student !== 'undefined' ? student : {}; %>
<% var parents = typeof parents !== 'undefined' ? parents : []; %>
<% var assignedParentIds = typeof assignedParentIds !== 'undefined' ? assignedParentIds : []; %>

<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <%- include('../../partials/alerts', { success: success, error: error }) %>

    <!-- Page Header -->
    <div class="px-4 py-6 sm:px-0 mb-8">
        <div class="flex justify-between items-center">
            <h1 class="text-3xl font-bold leading-tight text-gray-900">
                Edit Student: <%= student.name %>
            </h1>
            <!-- Removed Back to Students button -->
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="bg-white shadow-lg rounded-lg overflow-hidden border border-gray-200">
        <div class="px-6 py-5 bg-gray-50 border-b border-gray-200">
            <h2 class="text-xl font-semibold text-gray-800">Student Details</h2>
        </div>
        <form action="/admin/students/edit/<%= student._id %>" method="POST" class="px-6 py-6 space-y-4">
            <div>
                <label for="name" class="block text-sm font-medium text-gray-700">Full Name *</label>
                <input type="text" id="name" name="name" value="<%= values.name || student.name || '' %>" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
            </div>

            <div>
                <label for="dateOfBirth" class="block text-sm font-medium text-gray-700">Date of Birth *</label>
                <%
                    let dobValue = '';
                    if (values.dateOfBirth) {
                        dobValue = values.dateOfBirth;
                    } else if (student.dateOfBirth) {
                        try {
                            dobValue = new Date(student.dateOfBirth).toISOString().split('T')[0];
                        } catch (e) {
                            // Handle potential invalid date format if necessary
                        }
                    }
                %>
                <input type="date" id="dateOfBirth" name="dateOfBirth" value="<%= dobValue %>" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
            </div>

            <div>
                <label for="parentIds" class="block text-sm font-medium text-gray-700">Assign Parent(s)</label>
                <select multiple id="parentIds" name="parentIds" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm h-32">
                    <% if (parents.length > 0) { %>
                        <% parents.forEach(parent => { %>
                            <option value="<%= parent._id %>" <%= assignedParentIds.includes(parent._id.toString()) ? 'selected' : '' %>>
                                <%= parent.name %> (<%= parent.email %>)
                            </option>
                        <% }); %>
                    <% } else { %>
                        <option disabled>No parents available</option>
                    <% } %>
                </select>
                <p class="text-sm text-gray-500 mt-1">Hold Ctrl/Cmd to select multiple parents.</p>
            </div>

            <div class="pt-2 flex justify-end space-x-3">
                <a href="/admin/students" class="inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out">
                    Cancel
                </a>
                <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out">
                    Update Student
                </button>
            </div>
        </form>
    </div>
</div>
