<% var success = typeof success !== 'undefined' ? success : null; %>
<% var error = typeof error !== 'undefined' ? error : null; %>
<% var student = typeof student !== 'undefined' ? student : {}; %>
<% var parents = typeof parents !== 'undefined' ? parents : []; %>
<% var classes = typeof classes !== 'undefined' ? classes : []; %>

<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <%- include('../../partials/alerts', { success: success, error: error }) %>

    <!-- Page Header -->
    <div class="px-4 py-6 sm:px-0 mb-8">
        <div class="flex justify-between items-center">
            <h1 class="text-3xl font-bold leading-tight text-gray-900">
                Student Profile: <%= student.name %>
            </h1>
            <div class="flex items-center space-x-3">
                <a href="/admin/students/edit/<%= student._id %>" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                    Edit Student
                </a>
                <a href="/admin/students" class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    Back to Students
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="bg-white shadow-lg rounded-lg overflow-hidden border border-gray-200">
        <div class="px-6 py-5 bg-gray-50 border-b border-gray-200">
            <h2 class="text-xl font-semibold text-gray-800">Student Details</h2>
        </div>
        <div class="px-6 py-6">
            <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
                <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-gray-500">Name</dt>
                    <dd class="mt-1 text-sm text-gray-900"><%= student.name %></dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-gray-500">Date of Birth</dt>
                    <dd class="mt-1 text-sm text-gray-900"><%= student.formattedDob || 'Not set' %></dd>
                </div>
                <div class="sm:col-span-2">
                    <dt class="text-sm font-medium text-gray-500">Created At</dt>
                    <dd class="mt-1 text-sm text-gray-900">
                        <%= new Date(student.createdAt).toLocaleDateString() %> <%= new Date(student.createdAt).toLocaleTimeString() %>
                    </dd>
                </div>
            </dl>
        </div>
    </div>

    <!-- Parents Card -->
    <div class="bg-white shadow-lg rounded-lg overflow-hidden border border-gray-200 mt-8">
        <div class="px-6 py-5 bg-gray-50 border-b border-gray-200">
            <h2 class="text-xl font-semibold text-gray-800">Assigned Parents</h2>
        </div>
        <div class="px-6 py-6">
            <% if (parents && parents.length > 0) { %>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="border-b border-gray-300">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Name</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Email</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Phone</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <% parents.forEach(parent => { %>
                                <tr class="hover:bg-gray-50 transition duration-150 ease-in-out">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= parent.name %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= parent.email %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= parent.phone || 'Not set' %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p class="text-gray-500 italic">No parents assigned to this student.</p>
            <% } %>
        </div>
    </div>

    <!-- Classes Card -->
    <div class="bg-white shadow-lg rounded-lg overflow-hidden border border-gray-200 mt-8">
        <div class="px-6 py-5 bg-gray-50 border-b border-gray-200">
            <h2 class="text-xl font-semibold text-gray-800">Enrolled Classes</h2>
        </div>
        <div class="px-6 py-6">
            <% if (classes && classes.length > 0) { %>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="border-b border-gray-300">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Class Name</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Description</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Teacher</th>
                                <!-- Empty header for actions alignment -->
                                <th scope="col" class="relative px-6 py-3">
                                    <span class="sr-only">Actions</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <% classes.forEach(classObj => { %>
                                <tr class="hover:bg-gray-50 transition duration-150 ease-in-out" id="class-row-<%= classObj._id %>">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= classObj.name %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        <%= classObj.description ? (classObj.description.length > 50 ? classObj.description.substring(0, 50) + '...' : classObj.description) : 'No description' %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        <%= classObj.teacher ? classObj.teacher.name : 'Not Assigned' %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                        <div class="flex items-center justify-end space-x-2">
                                            <button
                                                type="button"
                                                onclick="showUnenrollModal('<%= classObj._id %>', '<%= student._id %>', '<%= student.name %>', '<%= classObj.name %>')"
                                                class="p-1.5 text-red-600 hover:text-red-800 hover:bg-red-100 rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition duration-150 ease-in-out"
                                                title="Unenroll Student">
                                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="py-6 text-center">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">No classes</h3>
                    <p class="mt-1 text-sm text-gray-500">This student is not enrolled in any classes.</p>
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Unenroll Confirmation Modal -->
<div id="unenroll-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 transition-opacity duration-300 ease-out opacity-0 pointer-events-none">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-md overflow-hidden transition-all duration-300 ease-out transform scale-95 opacity-0">
        <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex justify-between items-center">
            <h3 class="text-lg font-semibold text-red-700">Confirm Unenrollment</h3>
            <button id="close-unenroll-modal" class="text-gray-400 hover:text-gray-600 focus:outline-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div class="px-6 py-6 space-y-4">
            <p class="text-sm text-gray-700">Are you sure you want to unenroll <strong id="student-name"></strong> from the class <strong id="class-name"></strong>?</p>
            
            <div class="pt-2 flex justify-end space-x-3">
                <button type="button" id="cancel-unenroll-modal" class="py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out">
                    Cancel
                </button>
                <button type="button" id="confirm-unenroll-button" data-class-id="" data-student-id="" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition duration-150 ease-in-out">
                    Unenroll
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Unenroll Modal Functions
    const unenrollModal = document.getElementById('unenroll-modal');
    const unenrollModalContent = unenrollModal.querySelector('.bg-white');
    const studentNameSpan = document.getElementById('student-name');
    const classNameSpan = document.getElementById('class-name');
    const confirmUnenrollButton = document.getElementById('confirm-unenroll-button');

    // Function to show the modal with animation and populate data
    window.showUnenrollModal = function(classId, studentId, studentName, className) {
        // Set student and class names in confirmation message
        studentNameSpan.textContent = studentName;
        classNameSpan.textContent = className;

        // Store IDs on the confirm button
        confirmUnenrollButton.dataset.classId = classId;
        confirmUnenrollButton.dataset.studentId = studentId;

        // Show modal with animation
        unenrollModal.classList.remove('pointer-events-none');
        unenrollModal.classList.remove('opacity-0');
        unenrollModalContent.classList.remove('opacity-0', 'scale-95');
        unenrollModalContent.classList.add('opacity-100', 'scale-100');
    }

    // Function to hide the modal with animation
    function hideUnenrollModal() {
        unenrollModal.classList.add('opacity-0');
        unenrollModalContent.classList.add('opacity-0', 'scale-95');
        unenrollModalContent.classList.remove('opacity-100', 'scale-100');
        setTimeout(() => {
            unenrollModal.classList.add('pointer-events-none');
            // Clear data attributes when hiding
            confirmUnenrollButton.dataset.classId = '';
            confirmUnenrollButton.dataset.studentId = '';
            studentNameSpan.textContent = '';
            classNameSpan.textContent = '';
        }, 300); // Match duration-300
    }

    // Function to perform the unenroll action
    function confirmUnenroll() {
        const classId = confirmUnenrollButton.dataset.classId;
        const studentId = confirmUnenrollButton.dataset.studentId;

        if (!classId || !studentId) {
            console.error('Missing classId or studentId for unenrollment.');
            hideUnenrollModal();
            return;
        }

        fetch(`/admin/students/${studentId}/classes/${classId}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => {
            // Always reload the page. The server should set a flash message
            window.location.reload();
        })
        .catch(error => {
            console.error('Network error unenrolling student:', error);
            // Still reload the page to show any server-side error messages
            window.location.reload();
        });
        
        // Hide the modal immediately after initiating the fetch
        hideUnenrollModal();
    }

    // Event listeners for modal controls
    document.getElementById('close-unenroll-modal').addEventListener('click', hideUnenrollModal);
    document.getElementById('cancel-unenroll-modal').addEventListener('click', hideUnenrollModal);
    confirmUnenrollButton.addEventListener('click', confirmUnenroll);

    // Close modal on background click
    unenrollModal.addEventListener('click', function(e) {
        if (e.target === this) {
            hideUnenrollModal();
        }
    });
</script>