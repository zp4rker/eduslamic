<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Class - Education CRM</title>
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/classes.css">
</head>
<body>
    <div class="header">
        <h1>Education CRM</h1>
        <div class="user-info">
            <span class="user-name">Welcome, <%= user.name %></span>
            <a href="/classes" class="back-btn">Back to Classes</a>
            <a href="/classes/view/<%= classObj._id %>" class="view-btn">View Class</a>
            <a href="/auth/logout" class="logout-btn">Logout</a>
        </div>
    </div>
    
    <div class="container">
        <% if (error) { %>
            <div class="message error">
                <%= error %>
            </div>
        <% } %>
        
        <div class="card">
            <h2>Edit Class: <%= classObj.name %></h2>
            
            <form action="/classes/edit/<%= classObj._id %>" method="POST">
                <div class="form-group">
                    <label for="name">Class Name *</label>
                    <input 
                        type="text" 
                        id="name" 
                        name="name" 
                        value="<%= classObj.name %>" 
                        required
                    >
                </div>
                
                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea 
                        id="description" 
                        name="description"
                    ><%= classObj.description || '' %></textarea>
                </div>
                
                <div class="form-group">
                    <label for="teacher">Teacher</label>
                    <select id="teacher" name="teacherId">
                        <option value="">Select Teacher</option>
                        <% if (teachers && teachers.length > 0) { %>
                            <% teachers.forEach(teacher => { %>
                                <option 
                                    value="<%= teacher._id %>"
                                    <%= classObj.teacherId === teacher._id ? 'selected' : '' %>
                                >
                                    <%= teacher.name %> (<%= teacher.email %>)
                                </option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="schedule">Schedule/Meeting Time</label>
                    <input 
                        type="text" 
                        id="schedule" 
                        name="schedule" 
                        value="<%= classObj.schedule || '' %>" 
                        placeholder="e.g., Every Monday 4:00 PM - 5:30 PM"
                    >
                </div>
                
                <div class="form-group">
                    <label for="location">Location</label>
                    <input 
                        type="text" 
                        id="location" 
                        name="location" 
                        value="<%= classObj.location || '' %>" 
                        placeholder="e.g., Room 101 or Zoom Meeting"
                    >
                </div>
                
                <button type="submit">Update Class</button>
            </form>
        </div>
    </div>
</body>
</html>