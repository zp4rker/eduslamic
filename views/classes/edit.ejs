<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Class - Education CRM</title>
    <link rel="stylesheet" href="/styles/tailwind.css">
</head>
<body class="bg-gray-50 min-h-screen">
    <div class="bg-green-600 text-white px-6 py-4 flex items-center justify-between">
        <h1 class="text-2xl font-bold">Education CRM</h1>
        <div class="flex items-center space-x-4">
            <a href="/classes" class="px-4 py-2 rounded border border-white text-white hover:bg-white hover:text-black transition-colors duration-150">Back to Classes</a>
            <a href="/classes/view/<%= classObj._id %>" class="px-4 py-2 rounded border border-white text-white hover:bg-white hover:text-black transition-colors duration-150">View Class</a>
            <a href="/auth/logout" class="px-4 py-2 rounded border border-white text-white hover:bg-white hover:text-black transition-colors duration-150">Logout</a>
        </div>
    </div>
    <div class="max-w-5xl mx-auto mt-8 px-4">
        <% if (error) { %>
            <div class="mb-4 px-4 py-2 rounded bg-red-100 text-red-800 border border-red-300 text-center">
                <%= error %>
            </div>
        <% } %>
        <div class="bg-white border border-gray-200 rounded-lg shadow-md p-8 mb-8">
            <h2 class="text-xl font-semibold mb-6 text-gray-800">Edit Class: <%= classObj.name %></h2>
            <form action="/classes/edit/<%= classObj._id %>" method="POST" class="space-y-4 max-w-lg">
                <div>
                    <label for="name" class="block mb-1 font-medium text-gray-700">Class Name *</label>
                    <input type="text" id="name" name="name" value="<%= classObj.name %>" required class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
                </div>
                <div>
                    <label for="description" class="block mb-1 font-medium text-gray-700">Description</label>
                    <textarea id="description" name="description" class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full resize-vertical h-24"><%= classObj.description || '' %></textarea>
                </div>
                <div>
                    <label for="teacher" class="block mb-1 font-medium text-gray-700">Teacher</label>
                    <select id="teacher" name="teacherId" class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
                        <option value="">Select Teacher</option>
                        <% if (teachers && teachers.length > 0) { %>
                            <% teachers.forEach(teacher => { %>
                                <option value="<%= teacher._id %>" <%= classObj.teacherId === teacher._id ? 'selected' : '' %>>
                                    <%= teacher.name %> (<%= teacher.email %>)
                                </option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div>
                    <label for="schedule" class="block mb-1 font-medium text-gray-700">Schedule/Meeting Time</label>
                    <input type="text" id="schedule" name="schedule" value="<%= classObj.schedule || '' %>" placeholder="e.g., Every Monday 4:00 PM - 5:30 PM" class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
                </div>
                <div>
                    <label for="location" class="block mb-1 font-medium text-gray-700">Location</label>
                    <input type="text" id="location" name="location" value="<%= classObj.location || '' %>" placeholder="e.g., Room 101 or Zoom Meeting" class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
                </div>
                <button type="submit" class="w-full px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 font-semibold transition-colors duration-150">Update Class</button>
            </form>
        </div>
    </div>
</body>
</html>