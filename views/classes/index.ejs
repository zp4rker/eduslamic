<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Classes - Education CRM</title>
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/classes.css">
</head>
<body>
    <div class="header">
        <h1>Education CRM</h1>
        <div class="user-info">
            <span class="user-name">Welcome, <%= user.name %></span>
            <a href="/" class="dashboard-btn">Dashboard</a>
            <a href="/students" class="students-btn">Students</a>
            <a href="/auth/logout" class="logout-btn">Logout</a>
        </div>
    </div>
    
    <div class="container">
        <% if (success) { %>
            <div class="message success">
                <%= success %>
            </div>
        <% } %>
        
        <% if (error) { %>
            <div class="message error">
                <%= error %>
            </div>
        <% } %>
        
        <div class="card">
            <h2>
                Class Management
                <a href="/classes/create" class="btn">Add New Class</a>
            </h2>
            
            <% if (classes && classes.length > 0) { %>
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Teacher</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% classes.forEach(classObj => { %>
                            <tr>
                                <td><%= classObj.name %></td>
                                <td><%= classObj.description || 'No description' %></td>
                                <td><%= classObj.teacherName %></td>
                                <td class="actions">
                                    <a href="/classes/view/<%= classObj._id %>" class="btn">View</a>
                                    <a href="/classes/edit/<%= classObj._id %>" class="btn">Edit</a>
                                    <a href="/classes/<%= classObj._id %>/students" class="btn">Manage Students</a>
                                    <form action="/classes/delete/<%= classObj._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this class?');" style="display: inline;">
                                        <button type="submit" class="btn delete">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <p>No classes found. Add a new class to get started.</p>
            <% } %>
        </div>
    </div>
</body>
</html>