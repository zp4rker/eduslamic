<div class="max-w-5xl mx-auto mt-8 px-4">
    <%- include('../partials/alerts', { success: success, error: error }) %>
    <div class="bg-white border border-gray-200 rounded-lg shadow-md p-8 mb-8 space-y-6">
        <h2 class="text-xl font-semibold">Class Management</h2>
        <!-- Button to trigger modal -->
        <button id="add-class-button" type="button" class="mt-2 inline-block px-4 py-2 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-xl">Add New Class</button>
        <% if (classes && classes.length > 0) { %>
            <div class="overflow-x-auto mt-6">
                <table class="min-w-full bg-white border border-gray-200 rounded-lg">
                    <thead>
                        <tr class="bg-gray-100">
                            <th class="px-4 py-2 text-left font-medium text-gray-700">Name</th>
                            <th class="px-4 py-2 text-left font-medium text-gray-700">Description</th>
                            <th class="px-4 py-2 text-left font-medium text-gray-700">Teacher</th>
                            <th class="px-4 py-2 text-left font-medium text-gray-700">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% classes.forEach(classObj => { %>
                            <tr class="border-t border-gray-100 hover:bg-gray-50">
                                <td class="px-4 py-2"><%= classObj.name %></td>
                                <td class="px-4 py-2"><%= classObj.description || 'No description' %></td>
                                <td class="px-4 py-2"><%= classObj.teacherName %></td>
                                <td class="px-4 py-2">
                                    <div class="flex flex-wrap gap-2">
                                        <a href="/classes/view/<%= classObj._id %>" class="px-3 py-1 bg-blue-600 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-xl">View</a>
                                        <button 
                                            type="button" 
                                            class="edit-class-button px-3 py-1 bg-yellow-500 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-xl"
                                            data-id="<%= classObj._id %>"
                                            data-name="<%= classObj.name %>"
                                            data-description="<%= classObj.description || '' %>"
                                            data-teacher-id="<%= classObj.teacherId || '' %>">
                                            Edit
                                        </button>
                                        <a href="/classes/<%= classObj._id %>/students" class="px-3 py-1 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-xl">Manage Students</a>
                                        <form action="/classes/delete/<%= classObj._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this class?');" class="inline">
                                            <button type="submit" class="px-3 py-1 bg-red-600 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-xl">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p class="text-gray-600">No classes found. Add a new class to get started.</p>
        <% } %>
    </div>

    <!-- Modal for adding class -->
    <div id="add-class-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-40 hidden">
        <div class="bg-white rounded-lg shadow-lg w-full max-w-lg p-8 relative max-h-[90vh] overflow-y-auto">
            <button id="close-add-class-modal" class="absolute top-2 right-2 text-gray-400 hover:text-gray-700 focus:outline-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
            <h3 class="text-xl font-semibold mb-6 text-gray-800">Create New Class</h3>
            <!-- Class creation form -->
            <form action="/classes/create" method="POST" class="space-y-4">
                <div>
                    <label for="name" class="block mb-1 font-medium text-gray-700">Class Name *</label>
                    <input type="text" id="name" name="name" value="<%= typeof values !== 'undefined' ? values.name || '' : '' %>" required class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
                </div>
                <div>
                    <label for="description" class="block mb-1 font-medium text-gray-700">Description</label>
                    <textarea id="description" name="description" class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full resize-vertical h-24"><%= typeof values !== 'undefined' ? values.description || '' : '' %></textarea>
                </div>
                <div>
                    <label for="teacher" class="block mb-1 font-medium text-gray-700">Teacher</label>
                    <select id="teacher" name="teacherId" class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
                        <option value="">Select Teacher</option>
                        <% if (typeof teachers !== 'undefined' && teachers.length > 0) { %>
                            <% teachers.forEach(teacher => { %>
                                <option value="<%= teacher._id %>" <%= typeof values !== 'undefined' && values.teacherId === teacher._id ? 'selected' : '' %>>
                                    <%= teacher.name %> (<%= teacher.email %>)
                                </option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <button type="submit" class="w-full px-4 py-2 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-green-400 focus:ring-offset-2 transform hover:scale-105 hover:shadow-xl">
                    Create Class
                </button>
            </form>
        </div>
    </div>

    <!-- Modal for editing class -->
    <div id="edit-class-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-40 hidden">
        <div class="bg-white rounded-lg shadow-lg w-full max-w-lg p-8 relative max-h-[90vh] overflow-y-auto">
            <button id="close-edit-class-modal" class="absolute top-2 right-2 text-gray-400 hover:text-gray-700 focus:outline-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
            <h3 class="text-xl font-semibold mb-6 text-gray-800">Edit Class: <span id="edit-class-title"></span></h3>
            <!-- Class edit form -->
            <form id="edit-class-form" action="" method="POST" class="space-y-4">
                <div>
                    <label for="edit-name" class="block mb-1 font-medium text-gray-700">Class Name *</label>
                    <input type="text" id="edit-name" name="name" required class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
                </div>
                <div>
                    <label for="edit-description" class="block mb-1 font-medium text-gray-700">Description</label>
                    <textarea id="edit-description" name="description" class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full resize-vertical h-24"></textarea>
                </div>
                <div>
                    <label for="edit-teacher" class="block mb-1 font-medium text-gray-700">Teacher</label>
                    <select id="edit-teacher" name="teacherId" class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
                        <option value="">Select Teacher</option>
                        <% if (typeof teachers !== 'undefined' && teachers.length > 0) { %>
                            <% teachers.forEach(teacher => { %>
                                <option value="<%= teacher._id %>">
                                    <%= teacher.name %> (<%= teacher.email %>)
                                </option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <button type="submit" class="w-full px-4 py-2 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-green-400 focus:ring-offset-2 transform hover:scale-105 hover:shadow-xl">
                    Update Class
                </button>
            </form>
        </div>
    </div>

    <script>
        document.getElementById('add-class-button').addEventListener('click', function(e) {
            e.preventDefault();
            document.getElementById('add-class-modal').classList.remove('hidden');
        });
        document.getElementById('close-add-class-modal').addEventListener('click', function() {
            document.getElementById('add-class-modal').classList.add('hidden');
        });
        // Close modal on background click
        document.getElementById('add-class-modal').addEventListener('click', function(e) {
            if (e.target === this) {
                this.classList.add('hidden');
            }
        });

        // Edit class functionality
        const editButtons = document.querySelectorAll('.edit-class-button');
        editButtons.forEach(button => {
            button.addEventListener('click', function() {
                const classId = this.getAttribute('data-id');
                const className = this.getAttribute('data-name');
                const description = this.getAttribute('data-description');
                const teacherId = this.getAttribute('data-teacher-id');

                // Set form action URL
                document.getElementById('edit-class-form').action = `/classes/edit/${classId}`;
                
                // Fill form fields
                document.getElementById('edit-class-title').textContent = className;
                document.getElementById('edit-name').value = className;
                document.getElementById('edit-description').value = description;
                
                // Set teacher dropdown
                const teacherSelect = document.getElementById('edit-teacher');
                for (let i = 0; i < teacherSelect.options.length; i++) {
                    if (teacherSelect.options[i].value === teacherId) {
                        teacherSelect.options[i].selected = true;
                        break;
                    }
                }
                
                // Show modal
                document.getElementById('edit-class-modal').classList.remove('hidden');
            });
        });

        document.getElementById('close-edit-class-modal').addEventListener('click', function() {
            document.getElementById('edit-class-modal').classList.add('hidden');
        });

        // Close edit modal on background click
        document.getElementById('edit-class-modal').addEventListener('click', function(e) {
            if (e.target === this) {
                this.classList.add('hidden');
            }
        });
    </script>
</div>