<div class="w-full max-w-md bg-white rounded-lg shadow-md p-8">
    <h2 class="text-2xl font-bold text-center text-gray-800 mb-6">Login to Education CRM</h2>
    <% if (typeof error !== 'undefined') { %>
        <div class="mb-4 px-4 py-2 rounded bg-red-100 text-red-800 border border-red-300 text-center">
            <%= error %>
        </div>
    <% } %>
    <form action="/auth/login" method="POST" class="space-y-4">
        <div>
            <label for="email" class="block mb-1 font-medium text-gray-700">Email</label>
            <input 
                type="email" 
                id="email" 
                name="email" 
                value="<%= typeof values !== 'undefined' && values.email ? values.email : '' %>" 
                required
                class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500"
            >
        </div>
        <div>
            <label for="password" class="block mb-1 font-medium text-gray-700">Password</label>
            <input type="password" id="password" name="password" required class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500">
        </div>
        <button type="submit" class="w-full px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 font-semibold transition-colors duration-150">Login</button>
    </form>
    <div class="text-center mt-6 text-sm text-gray-600">
        Contact an administrator if you need an account.
    </div>
</div>