<div class="bg-green-600 text-white px-6 py-4 flex items-center justify-between">
    <div class="flex items-center gap-3">
        <% if (user) { %>
            <!-- Sidebar (hidden by default) -->
            <div id="sidebar" class="fixed top-0 left-0 h-full w-64 bg-white shadow-lg z-40 transform -translate-x-full transition-transform duration-300 flex flex-col">
                <div class="flex items-center justify-between px-4 py-4 border-b">
                    <span class="font-bold text-lg text-green-700">Menu</span>
                    <button id="sidebar-close" class="text-gray-500 hover:text-green-700 focus:outline-none">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
                <nav class="flex-1 flex flex-col gap-1 p-4">
                    <a href="/" class="block px-4 py-2 rounded text-gray-700 hover:bg-green-100 hover:text-green-700 transition">Dashboard</a>
                    <a href="/students" class="block px-4 py-2 rounded text-gray-700 hover:bg-green-100 hover:text-green-700 transition">Students</a>
                    <a href="/classes" class="block px-4 py-2 rounded text-gray-700 hover:bg-green-100 hover:text-green-700 transition">Classes</a>
                </nav>
            </div>
            <!-- Hamburger menu button -->
            <button id="nav-hamburger-button" type="button" class="flex items-center justify-center p-0 bg-transparent hover:bg-gray-100 rounded focus:outline-none focus:ring-2 focus:ring-green-400">
                <svg class="w-7 h-7 text-white hover:text-green-700 transition-colors duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
        <% } %>
        <h1 class="text-2xl font-bold">eduslamic</h1>
    </div>
    <div class="flex-1 flex justify-center">
    </div>
    <div class="flex items-center gap-3">
        <% if (user) { %>
            <!-- Profile dropdown -->
            <div class="relative" id="profile-menu-container">
                <button id="profile-menu-button" type="button" class="flex items-center justify-center w-10 h-10 rounded-full bg-white hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-green-400">
                    <!-- Improved User Icon SVG -->
                    <svg class="w-6 h-6 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                    </svg>
                </button>
                <div id="profile-menu-dropdown" class="hidden absolute right-0 mt-2 w-40 bg-white rounded-md shadow-lg py-1 z-20 border border-gray-200">
                    <a href="/profile/edit" class="block px-4 py-2 text-gray-700 hover:bg-gray-100">Edit Profile</a>
                    <a href="/auth/logout" class="block px-4 py-2 text-gray-700 hover:bg-gray-100">Logout</a>
                </div>
            </div>
            <script>
                // Sidebar logic
                document.addEventListener('DOMContentLoaded', function() {
                    const sidebar = document.getElementById('sidebar');
                    const openBtn = document.getElementById('nav-hamburger-button');
                    const closeBtn = document.getElementById('sidebar-close');
                    const pageWrapper = document.getElementById('page-wrapper');
                    function openSidebar(e) {
                        e.stopPropagation();
                        sidebar.classList.remove('-translate-x-full');
                        pageWrapper.style.marginLeft = '16rem';
                    }
                    function closeSidebar(e) {
                        if (e) e.stopPropagation();
                        sidebar.classList.add('-translate-x-full');
                        pageWrapper.style.marginLeft = '';
                    }
                    if (openBtn && sidebar && pageWrapper) {
                        openBtn.addEventListener('click', openSidebar);
                    }
                    if (closeBtn && sidebar && pageWrapper) {
                        closeBtn.addEventListener('click', closeSidebar);
                    }
                    // Close sidebar when clicking outside
                    document.addEventListener('click', function(e) {
                        if (
                            sidebar &&
                            !sidebar.classList.contains('-translate-x-full') &&
                            !sidebar.contains(e.target) &&
                            e.target !== openBtn
                        ) {
                            closeSidebar();
                        }
                    });
                });
                // Dropdown toggle logic for profile
                document.addEventListener('DOMContentLoaded', function() {
                    const btn = document.getElementById('profile-menu-button');
                    const menu = document.getElementById('profile-menu-dropdown');
                    document.addEventListener('click', function(e) {
                        if (btn && menu) {
                            if (btn.contains(e.target)) {
                                menu.classList.toggle('hidden');
                            } else if (!menu.contains(e.target)) {
                                menu.classList.add('hidden');
                            }
                        }
                    });
                });
            </script>
        <% } else { %>
            <a href="/auth/login" class="px-4 py-2 rounded border border-white text-white hover:bg-white hover:text-black transition-colors duration-150">Login</a>
        <% } %>
    </div>
</div>
