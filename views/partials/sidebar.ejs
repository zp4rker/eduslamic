<div id="sidebar" class="fixed top-0 left-0 h-full w-64 bg-white shadow-lg z-40 flex flex-col">
    <div class="flex items-center justify-center px-4 py-6 border-b">
        <span class="font-bold text-2xl text-green-700">eduslamic</span>
    </div>
    <nav class="flex-1 flex flex-col gap-1 p-4">
        <% if (user) { %>
            <a href="/" class="block px-4 py-2 rounded text-gray-700 hover:bg-green-100 hover:text-green-700 transition <%= currentPath === '/' ? 'bg-green-100 text-green-700 font-semibold' : '' %>">Dashboard</a>
            <% if (user.role === 'admin') { %>
                <div>
                    <button id="admin-menu-button" class="w-full flex items-center justify-between px-4 py-2 rounded text-gray-700 hover:bg-green-100 hover:text-green-700 transition focus:outline-none <%= currentPath.startsWith('/admin') ? 'bg-green-100 text-green-700 font-semibold' : '' %>">
                        <span>Admin</span>
                        <svg id="admin-menu-arrow" class="w-4 h-4 transform transition-transform duration-200 <%= currentPath.startsWith('/admin') ? 'rotate-180' : '' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                    </button>
                    <div id="admin-submenu" class="<%= currentPath.startsWith('/admin') ? '' : 'hidden' %> pl-4 mt-1 space-y-1">
                        <a href="/admin/students" class="block px-4 py-2 rounded text-gray-700 hover:bg-green-100 hover:text-green-700 transition <%= currentPath === '/admin/students' ? 'bg-green-100 text-green-700 font-semibold' : '' %>">Students</a>
                        <a href="/admin/classes" class="block px-4 py-2 rounded text-gray-700 hover:bg-green-100 hover:text-green-700 transition <%= currentPath === '/admin/classes' ? 'bg-green-100 text-green-700 font-semibold' : '' %>">Classes</a>
                        <a href="/admin/users" class="block px-4 py-2 rounded text-gray-700 hover:bg-green-100 hover:text-green-700 transition <%= currentPath === '/admin/users' ? 'bg-green-100 text-green-700 font-semibold' : '' %>">Users</a>
                    </div>
                </div>
            <% } %>
        <% } %>
    </nav>
    <div class="p-4 border-t flex flex-col items-start">
        <% if (user) { %>
            <div class="flex items-center gap-2">
                <div class="relative" id="profile-menu-container">
                    <button id="profile-menu-button" type="button" class="flex items-center gap-2 focus:outline-none">
                        <span class="flex items-center justify-center w-12 h-12 rounded-full bg-gray-100 hover:bg-gray-200">
                            <svg class="w-7 h-7 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                            </svg>
                        </span>
                        <span class="text-gray-700 font-medium cursor-pointer hover:underline"><%= user.name %></span>
                    </button>
                    <div id="profile-menu-dropdown" class="hidden absolute left-16 bottom-0 mb-2 w-48 bg-white rounded-xl shadow-2xl py-2 z-20 border border-gray-100 ring-1 ring-black/5 transition-all">
                        <a href="/profile/edit" class="flex items-center gap-2 px-5 py-3 text-gray-700 hover:bg-green-50 hover:text-green-700 transition rounded-lg font-medium <%= currentPath === '/profile/edit' ? 'bg-green-50 text-green-700' : '' %>">
                            <svg class="w-5 h-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4a4 4 0 110 8 4 4 0 010-8zm0 10c-4.418 0-8 1.79-8 4v2a1 1 0 001 1h14a1 1 0 001-1v-2c0-2.21-3.582-4-8-4z" />
                            </svg>
                            Your Profile
                        </a>
                        <a href="/auth/logout" class="flex items-center gap-2 px-5 py-3 text-gray-700 hover:bg-red-50 hover:text-red-700 transition rounded-lg font-medium">
                            <svg class="w-5 h-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H7a2 2 0 01-2-2V7a2 2 0 012-2h4a2 2 0 012 2v1" /></svg>
                            Logout
                        </a>
                    </div>
                </div>
            </div>
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    const btn = document.getElementById('profile-menu-button');
                    const menu = document.getElementById('profile-menu-dropdown');
                    document.addEventListener('click', function(e) {
                        if (btn && menu) {
                            if (btn.contains(e.target)) {
                                menu.classList.toggle('hidden');
                            } else if (!menu.contains(e.target)) {
                                menu.classList.add('hidden');
                            }
                        }
                    });
                });
            </script>
            <% if (user.role === 'admin') { %>
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    const adminBtn = document.getElementById('admin-menu-button');
                    const adminMenu = document.getElementById('admin-submenu');
                    const adminArrow = document.getElementById('admin-menu-arrow');
                    if (adminBtn && adminMenu && adminArrow) {
                        adminBtn.addEventListener('click', function() {
                            adminMenu.classList.toggle('hidden');
                            adminArrow.classList.toggle('rotate-180');
                        });
                    }
                });
            </script>
            <% } %>
        <% } else { %>
            <a href="/auth/login" class="w-full block px-4 py-2 bg-gradient-to-r from-green-500 to-green-600 text-white text-center rounded-lg shadow font-semibold transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-xl">Login</a>
        <% } %>
    </div>
</div>
