<div class="max-w-5xl mx-auto mt-8 px-4">
    <%- include('partials/alerts', { success: success, error: error }) %>
    <div class="bg-white border border-gray-200 rounded-lg shadow-md p-8 mb-8">
        <h2 class="text-xl font-semibold mb-6 text-gray-800">Profile Information</h2>
        <% 
        let roleBadgeClass = '';
        switch(user.role) {
            case 'admin':
                roleBadgeClass = 'bg-red-100 text-red-800 border border-red-300';
                break;
            case 'teacher':
                roleBadgeClass = 'bg-blue-100 text-blue-800 border border-blue-300';
                break;
            default:
                roleBadgeClass = 'bg-green-100 text-green-800 border border-green-300';
        }
        %>
        <div class="flex items-center gap-4 mb-6">
            <span class="inline-block px-3 py-1 rounded-full text-sm font-medium <%= roleBadgeClass %>"><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></span>
            <span class="text-gray-600">User ID: <%= user._id %></span>
        </div>
        <form action="/profile/update" method="POST" class="space-y-4 max-w-md">
            <div>
                <label for="name" class="block mb-1 font-medium text-gray-700">Full Name</label>
                <input type="text" id="name" name="name" value="<%= user.name %>" required class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
            </div>
            <div>
                <label for="email" class="block mb-1 font-medium text-gray-700">Email Address</label>
                <input type="email" id="email" name="email" value="<%= user.email %>" required class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
            </div>
            <div>
                <label for="phone" class="block mb-1 font-medium text-gray-700">Phone Number</label>
                <input type="tel" id="phone" name="phone" value="<%= user.phone %>" required class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
            </div>
            <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 transition-colors duration-150">Update Profile</button>
        </form>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg shadow-md p-8">
        <h2 class="text-xl font-semibold mb-6 text-gray-800">Change Password</h2>
        <form action="/profile/password" method="POST" class="space-y-4 max-w-md">
            <div>
                <label for="currentPassword" class="block mb-1 font-medium text-gray-700">Current Password</label>
                <input type="password" id="currentPassword" name="currentPassword" required class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
            </div>
            <div>
                <label for="newPassword" class="block mb-1 font-medium text-gray-700">New Password</label>
                <input type="password" id="newPassword" name="newPassword" required class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
            </div>
            <div>
                <label for="confirmPassword" class="block mb-1 font-medium text-gray-700">Confirm New Password</label>
                <input type="password" id="confirmPassword" name="confirmPassword" required class="px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 w-full">
            </div>
            <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 transition-colors duration-150">Update Password</button>
        </form>
    </div>
</div>