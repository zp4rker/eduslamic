<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Education CRM</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }
        .header {
            background-color: #4CAF50;
            color: white;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .header h1 {
            margin: 0;
            font-size: 24px;
        }
        .user-info {
            display: flex;
            align-items: center;
        }
        .user-name {
            margin-right: 15px;
        }
        .logout-btn, .edit-profile-btn {
            background-color: transparent;
            border: 1px solid white;
            color: white;
            padding: 5px 10px;
            border-radius: 3px;
            cursor: pointer;
            text-decoration: none;
            margin-left: 10px;
        }
        .logout-btn:hover, .edit-profile-btn:hover {
            background-color: rgba(255, 255, 255, 0.2);
        }
        .container {
            max-width: 1200px;
            margin: 20px auto;
            padding: 0 20px;
        }
        .welcome-card {
            background-color: white;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            padding: 20px;
            margin-bottom: 20px;
        }
        .info-card {
            background-color: white;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            padding: 20px;
            margin-bottom: 20px;
        }
        .info-card h2 {
            margin-top: 0;
            color: #333;
            border-bottom: 1px solid #eee;
            padding-bottom: 10px;
        }
        .user-details {
            display: grid;
            grid-template-columns: 120px 1fr;
            gap: 10px;
        }
        .label {
            font-weight: bold;
            color: #555;
        }
        .edit-link {
            display: inline-block;
            margin-top: 15px;
            color: #4CAF50;
            text-decoration: none;
        }
        .edit-link:hover {
            text-decoration: underline;
        }
        .role-badge {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 15px;
            font-size: 14px;
            font-weight: bold;
        }
        .role-admin {
            background-color: #d4edda;
            color: #155724;
        }
        .role-teacher {
            background-color: #cce5ff;
            color: #004085;
        }
        .role-parent {
            background-color: #fff3cd;
            color: #856404;
        }
        .role-section {
            margin-top: 30px;
        }
        .action-button {
            display: inline-block;
            background-color: #4CAF50;
            color: white;
            padding: 10px 15px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 16px;
            text-decoration: none;
            margin-right: 10px;
            margin-bottom: 10px;
        }
        .action-button:hover {
            background-color: #45a049;
        }
        .message {
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 4px;
        }
        .success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Education CRM</h1>
        <div class="user-info">
            <span class="user-name">Welcome, <%= user.name %></span>
            <a href="/profile/edit" class="edit-profile-btn">Edit Profile</a>
            <a href="/auth/logout" class="logout-btn">Logout</a>
        </div>
    </div>
    
    <div class="container">
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="message success">
                <%= success %>
            </div>
        <% } %>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="message error">
                <%= error %>
            </div>
        <% } %>
        
        <div class="welcome-card">
            <h2>Welcome to your Education CRM Dashboard</h2>
            <p>This is your personalized dashboard for the education CRM system.</p>
        </div>
        
        <div class="info-card">
            <h2>Your Profile</h2>
            <div class="user-details">
                <div class="label">Name:</div>
                <div><%= user.name %></div>
                
                <div class="label">Email:</div>
                <div><%= user.email %></div>
                
                <div class="label">Phone:</div>
                <div><%= user.phone %></div>
                
                <div class="label">Role:</div>
                <div>
                    <% 
                    let roleBadgeClass = '';
                    switch(user.role) {
                        case 'admin':
                            roleBadgeClass = 'role-admin';
                            break;
                        case 'teacher':
                            roleBadgeClass = 'role-teacher';
                            break;
                        default:
                            roleBadgeClass = 'role-parent';
                    }
                    %>
                    <span class="role-badge <%= roleBadgeClass %>">
                        <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>
                    </span>
                </div>
                
                <div class="label">User ID:</div>
                <div><%= user._id %></div>
                
                <div class="label">Joined:</div>
                <div><%= new Date(user.createdAt).toLocaleDateString() %></div>
            </div>
            <a href="/profile/edit" class="edit-link">Edit your profile information</a>
        </div>
        
        <!-- Role-specific content -->
        <div class="role-section">
            <% if (user.role === 'admin') { %>
                <div class="info-card">
                    <h2>Admin Actions</h2>
                    <p>As an administrator, you have exclusive access to user management:</p>
                    <div>
                        <a href="/auth/register" class="action-button">Create New User</a>
                        <a href="/students" class="action-button">Manage Students</a>
                        <a href="/classes" class="action-button">Manage Classes</a>
                        <!-- Add more admin actions here as you expand the CRM -->
                    </div>
                </div>
            <% } %>
            
            <% if (user.role === 'teacher') { %>
                <div class="info-card">
                    <h2>Teacher Dashboard</h2>
                    <p>Welcome to your teacher dashboard. Here you can manage your classes and students.</p>
                    <div>
                        <!-- Add teacher specific actions here as you expand the CRM -->
                        <button class="action-button" disabled>View My Classes</button>
                        <button class="action-button" disabled>Student Records</button>
                    </div>
                </div>
            <% } %>
            
            <% if (user.role === 'parent') { %>
                <div class="info-card">
                    <h2>Parent Dashboard</h2>
                    <p>Welcome to your parent dashboard. Here you can view your children's progress and communicate with teachers.</p>
                    <div>
                        <!-- Add parent specific actions here as you expand the CRM -->
                        <button class="action-button" disabled>View My Children</button>
                        <button class="action-button" disabled>Message Teachers</button>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>