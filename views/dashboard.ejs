<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Education CRM</title>
    <link rel="stylesheet" href="/styles/tailwind.css">
</head>
<body class="bg-gray-50 min-h-screen">
    <div class="bg-green-600 text-white px-6 py-4 flex items-center justify-between">
        <h1 class="text-2xl font-bold">Education CRM</h1>
        <div class="flex items-center space-x-4">
            <a href="/profile/edit" class="px-4 py-2 rounded border border-white text-white hover:bg-white hover:text-black transition-colors duration-150 mr-2">Edit Profile</a>
            <a href="/auth/logout" class="px-4 py-2 rounded border border-white text-white hover:bg-white hover:text-black transition-colors duration-150">Logout</a>
        </div>
    </div>
    
    <div class="max-w-5xl mx-auto mt-8 px-4">
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="mb-4 px-4 py-2 rounded bg-green-100 text-green-800 border border-green-300">
                <%= success %>
            </div>
        <% } %>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="mb-4 px-4 py-2 rounded bg-red-100 text-red-800 border border-red-300">
                <%= error %>
            </div>
        <% } %>
        
        <div class="bg-white border border-gray-200 rounded-lg shadow-md p-8 mb-8 space-y-6">
            <h2 class="text-xl font-semibold mb-6">Your Profile</h2>
            <% 
            let roleBadgeClass = '';
            switch(user.role) {
                case 'admin':
                    roleBadgeClass = 'bg-red-100 text-red-800 border border-red-300';
                    break;
                case 'teacher':
                    roleBadgeClass = 'bg-blue-100 text-blue-800 border border-blue-300';
                    break;
                default:
                    roleBadgeClass = 'bg-green-100 text-green-800 border border-green-300';
            }
            %>
            <div class="flex flex-col gap-2 text-base">
                <p><span class="font-medium text-gray-600">Name:</span> <span><%= user.name %></span></p>
                <p><span class="font-medium text-gray-600">Email:</span> <span><%= user.email %></span></p>
                <p><span class="font-medium text-gray-600">Phone:</span> <span><%= user.phone %></span></p>
                <p><span class="font-medium text-gray-600">Role:</span> <span class="inline-block px-3 py-1 rounded-full text-sm font-medium <%= roleBadgeClass %>"><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></span></p>
                <p><span class="font-medium text-gray-600">User ID:</span> <span><%= user._id %></span></p>
                <p><span class="font-medium text-gray-600">Joined:</span> <span><%= new Date(user.createdAt).toLocaleDateString() %></span></p>
            </div>
        </div>
        
        <!-- Role-specific content -->
        <div class="mt-8 space-y-8">
            <% if (user.role === 'admin') { %>
                <div class="bg-white border border-gray-200 rounded-lg shadow-md p-8 space-y-6">
                    <h2 class="text-xl font-semibold mb-6">Admin Actions</h2>
                    <p class="text-base mb-4">As an administrator, you have exclusive access to user management:</p>
                    <div class="flex flex-wrap gap-2">
                        <a href="/students" class="inline-block px-4 py-2 rounded bg-green-600 text-white hover:bg-green-700 transition-colors duration-150">Manage Students</a>
                        <a href="/classes" class="inline-block px-4 py-2 rounded bg-green-600 text-white hover:bg-green-700 transition-colors duration-150">Manage Classes</a>
                        <!-- Add more admin actions here as you expand the CRM -->
                    </div>
                </div>
            <% } %>
            
            <% if (user.role === 'teacher') { %>
                <div class="bg-white border border-gray-200 rounded-lg shadow-md p-8 space-y-6">
                    <h2 class="text-xl font-semibold mb-6">Teacher Dashboard</h2>
                    <p class="text-base mb-4">Welcome to your teacher dashboard. Here you can manage your classes and students.</p>
                    <div class="flex flex-wrap gap-2">
                        <!-- Add teacher specific actions here as you expand the CRM -->
                        <button class="inline-block px-4 py-2 rounded bg-blue-400 text-white opacity-60 cursor-not-allowed" disabled>View My Classes</button>
                        <button class="inline-block px-4 py-2 rounded bg-blue-400 text-white opacity-60 cursor-not-allowed" disabled>Student Records</button>
                    </div>
                </div>
            <% } %>
            
            <% if (user.role === 'parent') { %>
                <div class="bg-white border border-gray-200 rounded-lg shadow-md p-8 space-y-6">
                    <h2 class="text-xl font-semibold mb-6">Parent Dashboard</h2>
                    <p class="text-base mb-4">Welcome to your parent dashboard. Here you can view your children's progress and communicate with teachers.</p>
                    <div class="flex flex-wrap gap-2">
                        <!-- Add parent specific actions here as you expand the CRM -->
                        <button class="inline-block px-4 py-2 rounded bg-blue-400 text-white opacity-60 cursor-not-allowed" disabled>View My Children</button>
                        <button class="inline-block px-4 py-2 rounded bg-blue-400 text-white opacity-60 cursor-not-allowed" disabled>Message Teachers</button>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>