<div class="max-w-5xl mx-auto mt-8 px-4">
    <%- include('partials/alerts', { success: success, error: error }) %>
    <!-- Removed Your Profile section from dashboard. Profile info now only on profile page. -->
    <!-- Role-specific content -->
    <div class="mt-8 space-y-8">
        <% if (user.role === 'admin') { %>
            <div class="bg-white border border-gray-200 rounded-lg shadow-md p-8 space-y-6">
                <h2 class="text-xl font-semibold mb-6">Admin Actions</h2>
                <p class="text-base mb-4">As an administrator, you have exclusive access to user management:</p>
                <div class="flex flex-wrap gap-2">
                    <a href="/students" class="inline-block px-4 py-2 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-xl">Manage Students</a>
                    <a href="/classes" class="inline-block px-4 py-2 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-lg shadow font-semibold transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-xl">Manage Classes</a>
                    <!-- Add more admin actions here as you expand the CRM -->
                </div>
            </div>
        <% } %>
        <% if (user.role === 'teacher') { %>
            <div class="bg-white border border-gray-200 rounded-lg shadow-md p-8 space-y-6">
                <h2 class="text-xl font-semibold mb-6">Teacher Dashboard</h2>
                <p class="text-base mb-4">Welcome to your teacher dashboard. Here you can manage your classes and students.</p>
                <div class="flex flex-wrap gap-2">
                    <!-- Add teacher specific actions here as you expand the CRM -->
                    <button class="inline-block px-4 py-2 rounded bg-blue-400 text-white opacity-60 cursor-not-allowed" disabled>View My Classes</button>
                    <button class="inline-block px-4 py-2 rounded bg-blue-400 text-white opacity-60 cursor-not-allowed" disabled>Student Records</button>
                </div>
            </div>
        <% } %>
        <% if (user.role === 'parent') { %>
            <div class="bg-white border border-gray-200 rounded-lg shadow-md p-8 space-y-6">
                <h2 class="text-xl font-semibold mb-6">Parent Dashboard</h2>
                <p class="text-base mb-4">Welcome to your parent dashboard. Here you can view your children's progress and communicate with teachers.</p>
                <div class="flex flex-wrap gap-2">
                    <!-- Add parent specific actions here as you expand the CRM -->
                    <button class="inline-block px-4 py-2 rounded bg-blue-400 text-white opacity-60 cursor-not-allowed" disabled>View My Children</button>
                    <button class="inline-block px-4 py-2 rounded bg-blue-400 text-white opacity-60 cursor-not-allowed" disabled>Message Teachers</button>
                </div>
            </div>
        <% } %>
    </div>
</div>